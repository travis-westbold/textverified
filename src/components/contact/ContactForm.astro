---
/* The contact form.
 *
 * The live form is a plain server-rendered POST to /contact-us/form on the
 * Blazor app, and it is protected two ways: an ASP.NET antiforgery token
 * minted per request and bound to a `.AspNetCore.Antiforgery` cookie, and a
 * Cloudflare Turnstile check. Neither can be satisfied from a static page —
 * the token would have to come from their server, for our origin's cookie —
 * so this page cannot post to it, and pretending otherwise would drop real
 * support requests on the floor.
 *
 * So `action` is the switch. Left unset, the form validates and then offers
 * the message back — copy it, and open the form that works — and says so
 * before anyone types rather than after. The live form ignores query
 * parameters (checked: `?name=` and `?model.Name=` both leave the fields
 * empty), so handing the text over in a URL is not on the table; anything
 * that claimed to carry it across would be lying.
 *
 * Give it an endpoint that accepts these four fields and it submits normally.
 * Field names match the live form exactly, so whatever ends up behind it does
 * not need a mapping layer.
 */
import { links } from '../../config/links';

interface Props {
  /** where the form posts; unset means no endpoint exists yet */
  action?: string;
}
const { action } = Astro.props;

const FIELDS = [
  { name: 'model.Name', id: 'contact-name', label: 'Name', type: 'text', autocomplete: 'name', error: 'Please tell us your name.' },
  { name: 'model.Email', id: 'contact-email', label: 'Email', type: 'email', autocomplete: 'email', error: 'Please enter an email address we can reply to.' },
  { name: 'model.Subject', id: 'contact-subject', label: 'Subject', type: 'text', autocomplete: 'off', error: 'Please give your message a subject.' },
] as const;
const BODY = { name: 'model.Content', id: 'contact-body', label: 'Body', error: 'Please tell us how we can help.' };
---

<section class="form-section" aria-labelledby="form-heading" data-reveal>
  <h2 id="form-heading" class="sr-only">Send us a message</h2>
  <div class="shell">
    <contact-form class="card up" data-live={action ? 'true' : 'false'} data-fallback={links.contactFormLive}>
      {!action && (
        <p class="notice">
          <strong>This form isn't connected yet.</strong>
          It is here to be looked at, not sent — nothing you type will reach us.
          To actually contact support, use <a href={links.contactFormLive}>the working form</a>.
        </p>
      )}

      <form method="post" action={action}>
        {FIELDS.map((field) => (
          <div class="field">
            <label for={field.id}>{field.label}</label>
            <input
              type={field.type}
              id={field.id}
              name={field.name}
              autocomplete={field.autocomplete}
              required
              aria-describedby={`${field.id}-error`}
            />
            <p class="error" id={`${field.id}-error`} data-message={field.error} hidden></p>
          </div>
        ))}

        <div class="field">
          <label for={BODY.id}>{BODY.label}</label>
          <textarea id={BODY.id} name={BODY.name} rows="8" required aria-describedby={`${BODY.id}-error`}></textarea>
          <p class="error" id={`${BODY.id}-error`} data-message={BODY.error} hidden></p>
        </div>

        {/* Mount point for the Cloudflare Turnstile widget the live form
            carries. Nothing renders here yet and no space is held for it,
            because whether this page ends up needing it depends on what it
            posts to. Whoever wires it: Turnstile draws at 300x65 after its
            script loads, so give this slot that height in CSS at the same
            time, or the Send button jumps down the page on first paint. */}
        <div class="bot-check" data-turnstile-slot aria-hidden="true"></div>

        <button type="submit" class="button button-primary button-large">Send</button>
        <p class="status" role="status" aria-live="polite"></p>

        {!action && (
          <div class="handoff" hidden>
            <a class="button button-outline" href={links.contactFormLive}>Open the working form <span aria-hidden="true">↗</span></a>
            <button type="button" class="button button-outline" data-copy>Copy my message</button>
          </div>
        )}
      </form>
    </contact-form>
  </div>
</section>

<script>
  /* Validation is here rather than left to the browser so the messages match
     the page's voice and sit in the same place every time. The constraints
     stay on the inputs either way, so a browser running none of this still
     validates on submit — see the note by `novalidate` below. */
  class ContactForm extends HTMLElement {
    connectedCallback() {
      const form = this.querySelector('form')!;
      /* Turn the native bubbles off only once this script is running, so a
         browser without it still gets the browser's own validation rather
         than a form that accepts four empty fields. */
      form.setAttribute('novalidate', '');
      const status = this.querySelector<HTMLParagraphElement>('.status')!;
      const live = this.dataset.live === 'true';
      const fallback = this.dataset.fallback!;
      const controls = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea')];

      const handoff = this.querySelector<HTMLDivElement>('.handoff')!;
      let submitted = false;

      handoff?.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        const text = controls.map((control) => `${control.previousElementSibling?.textContent}: ${control.value}`).join('\n');
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = 'Copied';
        } catch {
          /* clipboard access can be refused outright; say so rather than
             leaving the button looking like it worked */
          button.textContent = 'Press Ctrl+C to copy';
          controls.at(-1)!.select();
        }
      });

      const errorFor = (control: HTMLInputElement | HTMLTextAreaElement) =>
        this.querySelector<HTMLParagraphElement>(`#${control.id}-error`)!;

      const check = (control: HTMLInputElement | HTMLTextAreaElement) => {
        const error = errorFor(control);
        const ok = control.value.trim() !== '' && control.checkValidity();
        /* the email field has two ways to be wrong, and "enter an email" is
           unhelpful once there is clearly something in the box */
        error.textContent = control.value.trim() === ''
          ? error.dataset.message!
          : 'Please check this looks like a complete email address.';
        error.hidden = ok;
        control.setAttribute('aria-invalid', String(!ok));
        control.classList.toggle('invalid', !ok);
        return ok;
      };

      for (const control of controls) {
        /* nothing is marked wrong until they have tried to send once —
           complaining while someone is still typing their first field is
           the fastest way to make a form feel hostile */
        control.addEventListener('blur', () => { if (submitted) check(control); });
        control.addEventListener('input', () => { if (submitted && control.classList.contains('invalid')) check(control); });
      }

      form.addEventListener('submit', (event) => {
        submitted = true;
        const bad = controls.filter((control) => !check(control));

        if (bad.length) {
          event.preventDefault();
          status.textContent = bad.length === 1
            ? 'One field still needs attention.'
            : `${bad.length} fields still need attention.`;
          status.classList.add('bad');
          bad[0].focus();
          return;
        }

        status.classList.remove('bad');

        if (!live) {
          /* No endpoint. Never navigate away here: the live form does not
             read query parameters, so leaving would discard what they wrote.
             Hand it back instead, and let them take it with them. */
          event.preventDefault();
          status.textContent = 'Nothing was sent — this form is not connected yet.';
          handoff.hidden = false;
          handoff.querySelector('a')!.focus();
          return;
        }

        status.textContent = 'Sending…';
      });
    }
  }

  customElements.define('contact-form', ContactForm);
</script>

<style>
  .form-section { padding: clamp(2.5rem, 5vw, 3.75rem) 0 clamp(4rem, 8vw, 6.5rem); color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* a form is read and filled in one column; the card holds it to a width the
     eye can track without the fields becoming letterboxes */
  .card { display: block; max-width: 36rem; margin-inline: auto; padding: clamp(1.5rem, 3vw, 2.25rem); background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.13rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.13rem 2.5rem -1.88rem rgb(15 23 43 / 50%); }

  .notice { margin: 0 0 1.5rem; padding: .85rem 1rem; color: #8a5a00; font-size: .86rem; line-height: 1.55; background: #fff8ec; border: 1px solid #f3dcb4; border-radius: .69rem; }
  .notice strong { display: block; color: #6f4800; font-weight: 800; }
  .notice a { color: #8a5a00; font-weight: 700; text-decoration: underline; text-underline-offset: 2px; }

  form { display: flex; flex-direction: column; gap: 1.15rem; }
  .field { display: flex; flex-direction: column; gap: .4rem; }
  label { font-size: .84rem; font-weight: 700; letter-spacing: .01em; }

  input, textarea { width: 100%; padding: .78rem .9rem; color: var(--text); font: inherit; font-size: .94rem; background: white; border: 1px solid var(--border); border-radius: .69rem; transition: border-color 180ms, box-shadow 180ms; }
  textarea { min-height: 9.5rem; line-height: 1.6; resize: vertical; }
  input:focus, textarea:focus { border-color: var(--border-blue); box-shadow: 0 0 0 4px rgb(0 105 168 / 10%); outline: none; }
  input.invalid, textarea.invalid { border-color: #d24b4b; }
  input.invalid:focus, textarea.invalid:focus { box-shadow: 0 0 0 4px rgb(210 75 75 / 12%); }

  .error { margin: 0; color: #c0392b; font-size: .8rem; font-weight: 600; }

  .bot-check:empty { display: none; }

  button[type='submit'] { justify-content: center; width: 100%; margin-top: .25rem; }
  /* an author display beats the UA rule for [hidden], so without this the
     hand-off is on the page from the start */
  .handoff[hidden] { display: none; }
  .handoff { display: flex; flex-wrap: wrap; gap: .5rem; }
  .handoff .button { flex: 1 1 12rem; justify-content: center; }
  .status { margin: 0; min-height: 1.25rem; color: var(--text-muted-card); font-size: .84rem; font-weight: 600; text-align: center; }
  .status.bad { color: #c0392b; }

  .up { opacity: 0; transform: translateY(1.5rem); transition: opacity 800ms cubic-bezier(.22,1,.36,1), transform 800ms cubic-bezier(.22,1,.36,1); }
  .form-section.revealed .up { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } }
</style>
