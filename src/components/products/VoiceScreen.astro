---
/* Voice verification: waiting → the call connects (timer runs, waveform
   turns green) → verified. */
import './mock.css';
import Loader from './Loader.astro';

const waveBars = Array.from({ length: 12 }, (_, index) => index);
---

<div class="tvm mock" data-voice-screen role="img" aria-label="Voice verification — an incoming call connecting">
  <div class="dtop"><span class="dbrand"><img src="/tvlogo.svg" alt="" loading="lazy" /></span>
    <span class="dtools"><span class="dcoin"><i></i>12.50</span><span class="dava"></span></span></div>
  <div class="dbody">
    <nav class="dside"><span>Inbox</span><span class="on">Verifications</span><span>Rentals</span><span>Support</span><span>Credits</span><span>API</span></nav>
    <div class="dmain">
      <div class="dhead"><b>Verifications</b><span class="dbtns"><span class="dbtn pri">New Voice Verification</span></span></div>
      <div class="dtabs"><span class="on">Active</span><span>History</span></div>
      <div class="dtable">
        <div class="drow dhr"><span>Created</span><span>Service</span><span>Number</span><span>Status</span></div>
        <div class="drow"><span>10:04</span><span class="dsvc"><i style="background:#6d4aff">tf</i>TextFree</span><span class="dnum">(206) 555-0117</span><span class="dst ok">Completed</span></div>
        <div class="drow"><span>09:58</span><span class="dsvc"><i style="background:#0071ce">W</i>Walmart</span><span class="dnum">(713) 555-0129</span><span class="dst ok">Completed</span></div>
      </div>
    </div>
  </div>
  <div class="scrim"></div>
  <div class="modal dense">
    <div class="mhead">Voice Verification <span class="x">✕</span></div>
    <div class="msvc"><i style="background:#6d4aff">tf</i>TextFree</div>
    <div class="mban warn" data-voice-banner><Loader /><span data-voice-banner-text>Waiting to receive a call from TextFree — don’t refresh this page</span></div>
    <div class="mlab">Use this phone number for TextFree</div>
    <div class="mnum">+1 (206) 555-0117 <span>Copy</span></div>
    <div class="mstats">
      <div class="mstat"><b>Verification cost</b><span>2.50</span></div>
      <div class="mstat"><b>Call timer</b><span data-voice-timer>0:00</span></div>
    </div>
    <div class="vsplit">
      <div class="wavebox" aria-hidden="true">
        {waveBars.map((bar) => <i style={`--d:${bar}`}></i>)}
      </div>
      <div class="dialpad" aria-hidden="true">
        <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span>
        <span>7</span><span>8</span><span>9</span><span>*</span><span>0</span><span>#</span>
      </div>
    </div>
  </div>
</div>

<script>
  import { prefersReducedMotion, runWhileVisible, wait } from '../../scripts/demo';

  const minuteSecond = (total: number) => `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;

  document.querySelectorAll<HTMLElement>('[data-voice-screen]').forEach((screen) => {
    const banner = screen.querySelector<HTMLElement>('[data-voice-banner]');
    const bannerText = screen.querySelector<HTMLElement>('[data-voice-banner-text]');
    const timer = screen.querySelector<HTMLElement>('[data-voice-timer]');
    const loader = banner?.querySelector<SVGElement>('.tvload');

    if (prefersReducedMotion()) {
      banner?.classList.remove('warn');
      banner?.classList.add('ok');
      if (loader) loader.style.display = 'none';
      if (bannerText) bannerText.textContent = 'Call complete — account verified';
      if (timer) timer.textContent = '0:31';
      return;
    }

    runWhileVisible(screen, async (stopped) => {
      while (!stopped()) {
        screen.classList.remove('oncall');
        if (banner) banner.className = 'mban warn';
        if (loader) loader.style.display = '';
        if (bannerText) bannerText.textContent = 'Waiting to receive a call from TextFree — don’t refresh this page';
        if (timer) timer.textContent = '0:00';
        await wait(2600);
        if (stopped()) return;
        screen.classList.add('oncall');
        if (banner) banner.className = 'mban';
        if (loader) loader.style.display = 'none';
        if (bannerText) bannerText.textContent = 'Call connected — follow the instructions to verify';
        for (let second = 1; second <= 6 && !stopped(); second++) {
          if (timer) timer.textContent = minuteSecond(second);
          await wait(1000);
        }
        if (stopped()) return;
        if (banner) banner.className = 'mban ok';
        if (bannerText) bannerText.textContent = 'Call complete — account verified';
        await wait(3200);
      }
    });
  });
</script>
