---
/* OPTION C — Editorial. No tiles, no chrome: numbered entries, the services
   named in words rather than drawn, and space doing the work. The quiet
   answer to a section that was previously the loudest thing on the page. */
interface Card { title: string; body: string; icons: string[] }
interface Props { kicker: string; heading: string; lede: string; cards: Card[] }
const { kicker, heading, lede, cards } = Astro.props;

const NAMES: Record<string, string> = {
  gmail: 'Gmail', discord: 'Discord', whatsapp: 'WhatsApp', telegram: 'Telegram',
  messenger: 'Messenger', wechat: 'WeChat', paypal: 'PayPal', venmo: 'Venmo',
  zelle: 'Zelle', amazon: 'Amazon', walmart: 'Walmart', target: 'Target',
  tinder: 'Tinder', instagram: 'Instagram', snapchat: 'Snapchat',
  reddit: 'Reddit', craigslist: 'Craigslist', airbnb: 'Airbnb',
};
const named = (keys: string[]) => keys.map((k) => NAMES[k] ?? k).join(' · ');
---

<section class="editorial" aria-labelledby="editorial-heading" data-reveal>
  <div class="shell">
    <header class="head up">
      <span class="kicker">{kicker}</span>
      <h2 id="editorial-heading">{heading}</h2>
      <p>{lede}</p>
    </header>

    <ol class="entries">
      {cards.map((card, i) => (
        <li class="entry up">
          <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="entry-body">
            <strong>{card.title}</strong>
            <p>{card.body}</p>
            <p class="services">{named(card.icons)}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .editorial { padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .head { max-width: 44rem; margin: 0 0 clamp(2.4rem, 5vw, 3.5rem); }
  .kicker { display: inline-flex; padding: .38rem .88rem; color: var(--brand); background: rgb(0 105 168 / 8%); border: 1px solid rgb(0 105 168 / 25%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .head p { margin: .95rem 0 0; color: #54637a; font-size: clamp(.94rem, 1.15vw, 1.06rem); line-height: 1.7; }

  .entries { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--border); }
  .entry { display: grid; grid-template-columns: 4.5rem minmax(0, 1fr); gap: clamp(1rem, 3vw, 2.5rem); padding: clamp(1.6rem, 3vw, 2.25rem) 0; border-bottom: 1px solid var(--border); }
  .num { color: var(--brand); font-size: clamp(1.5rem, 2.4vw, 2rem); font-weight: 800; letter-spacing: -.03em; line-height: 1; opacity: .45; }
  .entry-body { max-width: 46rem; }
  .entry-body strong { display: block; font-size: clamp(1.06rem, 1.5vw, 1.25rem); font-weight: 800; letter-spacing: -.015em; }
  .entry-body p { margin: .55rem 0 0; color: #5b6b82; font-size: .92rem; line-height: 1.65; }
  .services { margin-top: .85rem !important; color: var(--brand) !important; font-size: .78rem !important; font-weight: 700; letter-spacing: .02em; }

  .up { opacity: 0; transform: translateY(1.25rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1); }
  .editorial.revealed .up { opacity: 1; transform: none; }
  .entry.up:nth-child(2) { transition-delay: 90ms; } .entry.up:nth-child(3) { transition-delay: 180ms; }

  @media (max-width: 640px) { .entry { grid-template-columns: 1fr; gap: .5rem; } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } }
</style>
