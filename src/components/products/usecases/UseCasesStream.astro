---
/* OPTION B — Verified stream. Each card is a small piece of the real product:
   the service rows a customer actually sees, with the code landing and the
   row turning verified. Static markup — the rows are pre-resolved, so the
   card never changes size. */
import { brandIconPaths } from '../../../data/icons';

interface Card { title: string; body: string; icons: string[] }
interface Props { kicker: string; heading: string; lede: string; cards: Card[] }
const { kicker, heading, lede, cards } = Astro.props;

/* the rows read as a short verification log; codes are fixed sample values */
const rows = [
  { code: '481 209', when: 'just now' },
  { code: '730 664', when: '2m ago' },
  { code: '155 902', when: '6m ago' },
];
const label = (key: string) => key.charAt(0).toUpperCase() + key.slice(1);
---

<section class="stream" aria-labelledby="stream-heading" data-reveal>
  <div class="shell">
    <header class="head up">
      <span class="kicker">{kicker}</span>
      <h2 id="stream-heading">{heading}</h2>
      <p>{lede}</p>
    </header>

    <div class="grid">
      {cards.map((card) => (
        <article class="card up">
          <div class="log" aria-hidden="true">
            {card.icons.slice(0, 3).map((key, i) => (
              <div class="row">
                <span class="svc"><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd">{brandIconPaths[key].map((d) => <path d={d} />)}</svg>{label(key)}</span>
                <span class="code">{rows[i].code}</span>
                <span class="ok"><svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.6 6.4 5 8.8l4.4-5.4" /></svg></span>
              </div>
            ))}
          </div>
          <div class="body">
            <strong>{card.title}</strong>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .stream { padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .head { max-width: 44rem; margin: 0 auto clamp(2.1rem, 4.5vw, 3.25rem); text-align: center; }
  .kicker { display: inline-flex; padding: .38rem .88rem; color: var(--brand); background: rgb(0 105 168 / 8%); border: 1px solid rgb(0 105 168 / 25%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .head p { margin: .95rem 0 0; color: #54637a; font-size: clamp(.94rem, 1.15vw, 1.06rem); line-height: 1.7; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.88rem, 1.8vw, 1.38rem); }
  .card { display: flex; flex-direction: column; overflow: hidden; background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.13rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.13rem 2.5rem -1.88rem rgb(15 23 43 / 50%); }

  /* fixed row heights — the log is the same size on every card */
  .log { display: grid; gap: .4rem; padding: 1.1rem; background: #0f172b; }
  .row { display: flex; align-items: center; gap: .6rem; height: 2.35rem; padding: 0 .7rem; background: rgb(255 255 255 / 6%); border: 1px solid rgb(255 255 255 / 10%); border-radius: .6rem; }
  .svc { display: flex; align-items: center; gap: .45rem; flex: 1; min-width: 0; color: #dbe7f5; font-size: .76rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .svc svg { flex: 0 0 auto; width: .85rem; height: .85rem; color: #8fd8f5; }
  .code { color: #8fd8f5; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .74rem; font-weight: 700; letter-spacing: .04em; }
  .ok { display: grid; place-items: center; flex: 0 0 auto; width: 1.05rem; height: 1.05rem; background: #16a365; border-radius: 50%; }
  .ok svg { width: .55rem; height: .55rem; fill: none; stroke: white; stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }

  .body { padding: 1.25rem 1.38rem 1.5rem; }
  .body strong { display: block; font-size: .97rem; font-weight: 800; }
  .body p { margin: .5rem 0 0; color: #5b6b82; font-size: .84rem; line-height: 1.6; }

  .up { opacity: 0; transform: translateY(1.25rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1); }
  .stream.revealed .up { opacity: 1; transform: none; }
  .card.up:nth-child(2) { transition-delay: 90ms; } .card.up:nth-child(3) { transition-delay: 180ms; }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; max-width: 30rem; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } }
</style>
