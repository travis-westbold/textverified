---
/* OPTION B — Verified stream. Each card is a short verification log. Per row
   the brand mark's four bars dance along a flat line, drop into their real
   checkmark formation, fade from grey to green, then slide left to reveal
   "Verified". Rows are staggered so they land one after another.

   One 6s timeline drives every phase, so nothing can drift out of step. The
   whole row reserves its final width from the start — the word is laid out
   from the first frame and only fades in — so nothing resizes mid-sequence. */
import { brandIconPaths } from '../../../data/icons';

interface Card { title: string; body: string; icons: string[] }
interface Props { kicker: string; heading: string; lede: string; cards: Card[] }
const { kicker, heading, lede, cards } = Astro.props;

const rows = [{ code: '481 209' }, { code: '730 664' }, { code: '155 902' }];
const label = (key: string) => key.charAt(0).toUpperCase() + key.slice(1);

/* the mark's bars, with the vertical offset that flattens each to one line */
const BARS = [
  { x: 6.33, y: 35.157, line: 0 },
  { x: 22.95, y: 44.328, line: -9.171 },
  { x: 39.58, y: 35.157, line: 0 },
  { x: 56.2, y: 25.977, line: 9.18 },
];
---

<section class="stream" aria-labelledby="stream-heading" data-animated-section data-reveal>
  <div class="shell">
    <header class="head up">
      <span class="kicker">{kicker}</span>
      <h2 id="stream-heading">{heading}</h2>
      <p>{lede}</p>
    </header>

    <div class="grid">
      {cards.map((card, cardIndex) => (
        <article class="card up">
          <div class="log" aria-hidden="true">
            {card.icons.slice(0, 3).map((key, i) => (
              <div class="row" style={`--row: ${cardIndex * 3 + i}`}>
                <span class="svc"><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd">{brandIconPaths[key].map((d) => <path d={d} />)}</svg>{label(key)}</span>
                <span class="code">{rows[i].code}</span>
                <span class="status">
                  <span class="badge">
                    <svg class="tvmark" viewBox="0 16 74 56">
                      {BARS.map((bar) => (
                        <g class="bar" style={`--line: ${bar.line}`}>
                          <rect x={bar.x} y={bar.y} width="11.28" height="17.07" rx="1.83" />
                        </g>
                      ))}
                    </svg>
                  </span>
                  <span class="word">Verified</span>
                </span>
              </div>
            ))}
          </div>
          <div class="body">
            <strong>{card.title}</strong>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  /* the sequence sleeps while the section is off-screen —
     [data-animation-state='paused'] is defined globally */
  document.querySelectorAll<HTMLElement>('.stream[data-animated-section]').forEach((section) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(([entry]) => {
      section.dataset.animationState = entry.isIntersecting ? 'running' : 'paused';
    }).observe(section);
  });
</script>

<style>
  .stream { padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .head { max-width: 44rem; margin: 0 auto clamp(2.1rem, 4.5vw, 3.25rem); text-align: center; }
  .kicker { display: inline-flex; padding: .38rem .88rem; color: var(--brand); background: rgb(0 105 168 / 8%); border: 1px solid rgb(0 105 168 / 25%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .head p { margin: .95rem 0 0; color: #54637a; font-size: clamp(.94rem, 1.15vw, 1.06rem); line-height: 1.7; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.88rem, 1.8vw, 1.38rem); }
  .card { display: flex; flex-direction: column; overflow: hidden; background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.13rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.13rem 2.5rem -1.88rem rgb(15 23 43 / 50%); }

  .log { display: grid; gap: .4rem; padding: 1.1rem; background: #0f172b; }
  .row { display: flex; align-items: center; gap: .6rem; height: 2.35rem; padding: 0 .7rem; background: rgb(255 255 255 / 6%); border: 1px solid rgb(255 255 255 / 10%); border-radius: .6rem; }
  .svc { display: flex; align-items: center; gap: .45rem; flex: 1; min-width: 0; color: #dbe7f5; font-size: .76rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* service marks stay grey — the only colour in the row is the check */
  .svc svg { flex: 0 0 auto; width: .85rem; height: .85rem; color: #94a3b8; }
  .code { color: #8fa3bd; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .74rem; font-weight: 700; letter-spacing: .04em; }

  /* fixed width, reserved for the finished "✓ Verified" state from frame one */
  .status { display: flex; align-items: center; justify-content: flex-start; gap: .42rem; flex: 0 0 4.9rem; }
  .badge { display: grid; place-items: center; flex: 0 0 auto; width: 1.4rem; height: 1.08rem; animation: st-slide 6s ease-in-out infinite; animation-delay: calc(var(--row) * .55s); }
  .tvmark { width: 100%; height: 100%; overflow: visible; }
  .bar { transform: translateY(calc(var(--line) * 1px)); animation: st-form 6s ease-in-out infinite; animation-delay: calc(var(--row) * .55s); }
  .bar rect { fill: #94a3b8; animation: st-bar 6s ease-in-out infinite; animation-delay: calc(var(--row) * .55s); }
  .bar:nth-of-type(2) rect { animation-delay: calc(var(--row) * .55s + .07s); }
  .bar:nth-of-type(3) rect { animation-delay: calc(var(--row) * .55s + .14s); }
  .bar:nth-of-type(4) rect { animation-delay: calc(var(--row) * .55s + .21s); }
  .word { color: #37e0a0; font-size: .7rem; font-weight: 800; letter-spacing: .02em; white-space: nowrap; opacity: 0; animation: st-word 6s ease-in-out infinite; animation-delay: calc(var(--row) * .55s); }

  /* phase 1 flat + dancing, phase 2 into the checkmark, phase 3 to green */
  @keyframes st-form {
    0%, 26% { transform: translateY(calc(var(--line) * 1px)); }
    38%, 100% { transform: translateY(0); }
  }
  @keyframes st-bar {
    0% { opacity: .35; transform: translateY(0); fill: #94a3b8; }
    7% { opacity: 1; transform: translateY(-3px); }
    14% { opacity: .35; transform: translateY(0); }
    21% { opacity: 1; transform: translateY(-3px); }
    26% { opacity: .6; transform: translateY(0); fill: #94a3b8; }
    38% { opacity: 1; fill: #94a3b8; }
    46%, 100% { opacity: 1; transform: translateY(0); fill: #37e0a0; }
  }
  /* the mark starts centred in the reserved space, then slides left */
  @keyframes st-slide {
    0%, 46% { transform: translateX(1.7rem); }
    57%, 100% { transform: translateX(0); }
  }
  @keyframes st-word {
    0%, 48% { opacity: 0; transform: translateX(-.3rem); }
    60%, 100% { opacity: 1; transform: translateX(0); }
  }

  .body { padding: 1.25rem 1.38rem 1.5rem; }
  .body strong { display: block; font-size: .97rem; font-weight: 800; }
  .body p { margin: .5rem 0 0; color: #5b6b82; font-size: .84rem; line-height: 1.6; }

  .up { opacity: 0; transform: translateY(1.25rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1); }
  .stream.revealed .up { opacity: 1; transform: none; }
  .card.up:nth-child(2) { transition-delay: 90ms; } .card.up:nth-child(3) { transition-delay: 180ms; }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; max-width: 30rem; margin-inline: auto; } }
  /* reduced motion and data-saver settle on the finished state */
  @media (prefers-reduced-motion: reduce), (prefers-reduced-data: reduce) {
    .badge, .bar, .bar rect, .word { animation: none; }
    .bar { transform: translateY(0); }
    .bar rect { fill: #37e0a0; opacity: 1; }
    .word { opacity: 1; }
    .up { opacity: 1; transform: none; transition: none; }
  }
</style>
