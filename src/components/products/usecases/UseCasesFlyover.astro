---
/* OPTION A — Flyover. One isometric lattice, the hero's own motif, drifting
   slowly behind the whole section while the cards sit still above it. The
   field is a single compositor transform on one element (not a field of
   animated chips), it pauses off-screen, and reduced motion stops it. */
import IsoField from '../../IsoField.astro';
import { brandIconPaths } from '../../../data/icons';

interface Card { title: string; body: string; icons: string[] }
interface Props { kicker: string; heading: string; lede: string; cards: Card[] }
const { kicker, heading, lede, cards } = Astro.props;
---

<section class="fly" aria-labelledby="fly-heading" data-animated-section data-reveal>
  <div class="drift" aria-hidden="true">
    <IsoField side="left" count={16} columns={4} />
    <IsoField side="right" count={16} columns={4} />
  </div>

  <div class="shell">
    <header class="head up">
      <span class="kicker">{kicker}</span>
      <h2 id="fly-heading">{heading}</h2>
      <p>{lede}</p>
    </header>

    <div class="grid">
      {cards.map((card) => (
        <article class="card up">
          <div class="marks" aria-hidden="true">
            {card.icons.map((key) => (
              <span class="pip"><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd">{brandIconPaths[key].map((d) => <path d={d} />)}</svg></span>
            ))}
          </div>
          <strong>{card.title}</strong>
          <p>{card.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.fly[data-animated-section]').forEach((section) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(([entry]) => {
      section.dataset.animationState = entry.isIntersecting ? 'running' : 'paused';
    }).observe(section);
  });
</script>

<style>
  .fly { position: relative; isolation: isolate; overflow: hidden; padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: white; background: linear-gradient(180deg, #0f172b 0%, #070d1a 100%); }
  /* one element, one transform — the lattice inside it stays static SVG */
  .drift { position: absolute; z-index: -2; inset: -18% -4%; will-change: transform; animation: fly-drift 90s linear infinite alternate; }
  @keyframes fly-drift { to { transform: translate3d(-6%, -3%, 0); } }
  /* only enough scrim to keep the heading legible over the lattice */
  .fly::after { content: ''; position: absolute; z-index: -1; inset: 0 0 auto; height: 62%; background: radial-gradient(52% 76% at 50% 28%, rgb(7 13 26 / 78%) 0%, rgb(7 13 26 / 34%) 58%, transparent 80%); pointer-events: none; }

  .head { max-width: 44rem; margin: 0 auto clamp(2.1rem, 4.5vw, 3.25rem); text-align: center; }
  .kicker { display: inline-flex; padding: .38rem .88rem; color: #8fd8f5; background: rgb(17 177 234 / 10%); border: 1px solid rgb(17 177 234 / 30%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .head p { margin: .95rem 0 0; color: #a9bcd8; font-size: clamp(.94rem, 1.15vw, 1.06rem); line-height: 1.7; }

  .grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.88rem, 1.8vw, 1.38rem); }
  .card { padding: 1.5rem 1.45rem 1.6rem; color: var(--text); background: white; border-radius: 1.13rem; box-shadow: 0 1.5rem 3.4rem -1.9rem rgb(0 0 0 / 85%); }
  .marks { display: flex; flex-wrap: wrap; align-items: center; gap: .38rem; margin-bottom: 1.1rem; }
  .pip { display: grid; place-items: center; width: 1.85rem; height: 1.85rem; color: #8394ab; background: var(--surface-subtle); border: 1px solid rgb(15 23 43 / 10%); border-radius: .55rem; }
  .pip svg { width: .95rem; height: .95rem; }
  .card strong { display: block; font-size: .97rem; font-weight: 800; }
  .card p { margin: .5rem 0 0; color: #5b6b82; font-size: .84rem; line-height: 1.6; }

  .up { opacity: 0; transform: translateY(1.25rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1); }
  .fly.revealed .up { opacity: 1; transform: none; }
  .card.up:nth-child(2) { transition-delay: 90ms; } .card.up:nth-child(3) { transition-delay: 180ms; }

  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; max-width: 30rem; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .drift { animation: none; } .up { opacity: 1; transform: none; transition: none; } }
  @media (prefers-reduced-data: reduce) { .drift { animation: none; } }
</style>
