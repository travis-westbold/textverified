---
/* The old products page's "Additional Features" lists, as card grids.
   Card bodies are trusted first-party copy and may embed links. */
interface Card {
  icon: 'refresh' | 'globe' | 'refund' | 'list' | 'bulk' | 'bolt' | 'chat';
  title: string;
  body: string;
}

interface Props {
  kicker: string;
  heading: string;
  cards: Card[];
}

const { kicker, heading, cards } = Astro.props;
---

<section class="extras" data-reveal>
  <div class="shell">
    <header class="extras-head up">
      <span class="kicker">{kicker}</span>
      <h2>{heading}</h2>
    </header>
    <div class:list={['extras-grid', { three: cards.length === 3 }]}>
      {cards.map((card) => (
        <article class="extra-card up">
          <span class="extra-icon" aria-hidden="true">
            {card.icon === 'refresh' && <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4" /><path d="M21 3v6h-6" /></svg>}
            {card.icon === 'globe' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18" /><path d="M12 3a14 14 0 0 0 0 18" /></svg>}
            {card.icon === 'refund' && <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l3 2" /></svg>}
            {card.icon === 'list' && <svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10" /></svg>}
            {card.icon === 'bulk' && <svg viewBox="0 0 24 24"><path d="M20 7h-9M20 12h-9M20 17h-9" /><circle cx="5" cy="7" r="1" /><circle cx="5" cy="12" r="1" /><circle cx="5" cy="17" r="1" /></svg>}
            {card.icon === 'bolt' && <svg viewBox="0 0 24 24"><path d="M13 2 3 14h8l-1 8 10-12h-8z" /></svg>}
            {card.icon === 'chat' && <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8z" /></svg>}
          </span>
          <strong>{card.title}</strong>
          <p set:html={card.body}></p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .extras { padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .extras-head { max-width: 44rem; margin: 0 auto clamp(2.1rem, 4.5vw, 3.25rem); text-align: center; }
  .kicker { display: inline-flex; align-items: center; padding: .38rem .88rem; color: var(--brand); background: rgb(0 105 168 / 8%); border: 1px solid rgb(0 105 168 / 25%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .extras-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(.88rem, 1.8vw, 1.38rem); }
  .extras-grid.three { grid-template-columns: repeat(3, 1fr); max-width: 63.75rem; margin-inline: auto; }
  .extra-card { padding: 1.38rem; background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.13rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.13rem 2.5rem -1.88rem rgb(15 23 43 / 50%); transition: border-color 300ms, transform 300ms cubic-bezier(.22,1,.36,1), box-shadow 300ms cubic-bezier(.22,1,.36,1); }
  .extra-card:hover { border-color: rgb(0 105 168 / 35%); transform: translateY(-3px); box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.5rem 2.9rem -1.75rem rgb(15 23 43 / 55%); }
  .extra-icon { display: grid; place-items: center; width: 2.38rem; height: 2.38rem; margin-bottom: .88rem; border-radius: .75rem; background: rgb(0 105 168 / 9%); border: 1px solid rgb(0 105 168 / 22%); color: var(--brand); }
  .extra-icon svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .extra-card strong { display: block; font-size: .97rem; font-weight: 800; }
  .extra-card p { margin: .5rem 0 0; color: #5b6b82; font-size: .84rem; line-height: 1.6; }
  .extra-card p :global(a) { color: var(--brand); text-decoration: underline; text-underline-offset: 2px; }

  .up { opacity: 0; transform: translateY(1.5rem); transition: opacity 800ms cubic-bezier(.22,1,.36,1), transform 800ms cubic-bezier(.22,1,.36,1); }
  .extras.revealed .up { opacity: 1; transform: none; }
  .extra-card.up:nth-child(2) { transition-delay: 90ms; }
  .extra-card.up:nth-child(3) { transition-delay: 180ms; }
  .extra-card.up:nth-child(4) { transition-delay: 270ms; }

  @media (max-width: 940px) { .extras-grid, .extras-grid.three { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) { .extras-grid, .extras-grid.three { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } .extra-card { transition: none; } }
</style>
