---
/* Popular use cases. The old page backed each card with a full-colour collage
   of third-party app icons; those clash with the brand, so the services are
   redrawn here as build-time SVG marks in the muted tile treatment the rest
   of the site uses. No images, per the public-page rule. */
import { brandIconPaths } from '../../data/icons';

interface Card {
  title: string;
  body: string;
  icons: string[];
}

interface Props {
  kicker: string;
  heading: string;
  lede: string;
  cards: Card[];
  tone?: 'light' | 'dark';
}

const { kicker, heading, lede, cards, tone = 'light' } = Astro.props;

/* fail the build on a typo rather than silently dropping a mark */
for (const card of cards) {
  for (const key of card.icons) {
    if (!brandIconPaths[key]) {
      throw new Error(`UseCases: "${key}" is not a brand mark in src/data/icons.ts`);
    }
  }
}
---

<section class:list={['usecases', tone]} aria-labelledby="usecases-heading" data-reveal>
  <div class="shell">
    <header class="usecases-head up">
      <span class="kicker">{kicker}</span>
      <h2 id="usecases-heading">{heading}</h2>
      <p>{lede}</p>
    </header>

    <div class="usecase-grid">
      {cards.map((card) => (
        <article class="usecase up">
          <div class="marks" aria-hidden="true">
            {card.icons.map((key) => (
              <span class="mark-tile">
                <svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd">
                  {brandIconPaths[key].map((path) => <path d={path} />)}
                </svg>
              </span>
            ))}
          </div>
          <div class="usecase-body">
            <strong>{card.title}</strong>
            <p>{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .usecases { padding: clamp(3.75rem, 7.5vw, 6.25rem) 0; color: var(--text); background: linear-gradient(180deg, white 0%, #f2f5f9 100%); }
  .usecases.dark { color: white; background: linear-gradient(180deg, #0f172b 0%, #070d1a 100%); }
  .usecases-head { max-width: 44rem; margin: 0 auto clamp(2.1rem, 4.5vw, 3.25rem); text-align: center; }
  .kicker { display: inline-flex; align-items: center; padding: .38rem .88rem; color: var(--brand); background: rgb(0 105 168 / 8%); border: 1px solid rgb(0 105 168 / 25%); border-radius: 999px; font-size: .72rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  .usecases.dark .kicker { color: #8fd8f5; background: rgb(17 177 234 / 10%); border-color: rgb(17 177 234 / 30%); }
  h2 { margin: 1rem 0 0; font-size: clamp(1.63rem, 3vw, 2.5rem); font-weight: 800; letter-spacing: -.028em; line-height: 1.14; }
  .usecases-head p { margin: .95rem 0 0; color: #54637a; font-size: clamp(.94rem, 1.15vw, 1.06rem); line-height: 1.7; }
  .usecases.dark .usecases-head p { color: #a9bcd8; }

  .usecase-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.88rem, 1.8vw, 1.38rem); }
  /* the cards stay white on either ground, so their copy sets its own colour */
  .usecase { display: flex; flex-direction: column; overflow: hidden; color: var(--text); background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.13rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.13rem 2.5rem -1.88rem rgb(15 23 43 / 50%); transition: border-color 300ms, transform 300ms cubic-bezier(.22,1,.36,1), box-shadow 300ms cubic-bezier(.22,1,.36,1); }
  .usecase:hover { border-color: rgb(0 105 168 / 35%); transform: translateY(-3px); box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.5rem 2.9rem -1.75rem rgb(15 23 43 / 55%); }

  /* the service lattice replaces the old logo photo — a fixed 3x2 grid, so the
     panel is the same height on every card whatever it holds */
  .marks { display: grid; grid-template-columns: repeat(3, 1fr); gap: .5rem; padding: 1.38rem; background: var(--surface-subtle); border-bottom: 1px solid rgb(15 23 43 / 8%); }
  .mark-tile { display: grid; place-items: center; aspect-ratio: 1; color: #8394ab; background: white; border: 1px solid rgb(15 23 43 / 10%); border-radius: .7rem; }
  .mark-tile svg { width: 1.15rem; height: 1.15rem; }

  .usecase-body { padding: 1.25rem 1.38rem 1.5rem; }
  .usecase-body strong { display: block; font-size: .97rem; font-weight: 800; }
  .usecase-body p { margin: .5rem 0 0; color: #5b6b82; font-size: .84rem; line-height: 1.6; }

  .up { opacity: 0; transform: translateY(1.25rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1); }
  .usecases.revealed .up { opacity: 1; transform: none; }
  .usecase.up:nth-child(2) { transition-delay: 90ms; }
  .usecase.up:nth-child(3) { transition-delay: 180ms; }

  @media (max-width: 900px) { .usecase-grid { grid-template-columns: 1fr; max-width: 30rem; margin-inline: auto; } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } }
</style>
