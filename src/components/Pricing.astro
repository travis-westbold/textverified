---
import { getCollection, getEntry } from 'astro:content';
import { links } from '../config/links';
import Swoosh from './Swoosh.astro';

const page = await getEntry('home', 'home');
if (!page) throw new Error('src/content/pages/home.yaml is missing');
const head = page.data.pricingHead;

const pricingPlans = (await getCollection('pricing'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => entry.data);
import PaymentMarks from './PaymentMarks.astro';
---

<section class="pricing" id="pricing" aria-labelledby="pricing-heading">
  <span class="hexagon hexagon-left" aria-hidden="true"></span><span class="hexagon hexagon-right" aria-hidden="true"></span>
  <div class="shell pricing-inner">
    <header class="pricing-head">
      <h2 id="pricing-heading"><span>{head.headingPre} </span><span class="mark"><em>{head.markEm}</em><Swoosh /></span></h2>
      <p>{head.lede}</p>
    </header>
    <div class="plans">
      {pricingPlans.map((plan) => (
        <article class:list={['plan', { featured: plan.featured }]}>
          {plan.featured && <span class="featured-flag">Most flexible</span>}
          <span class="starting">Starting at…</span>
          <div class="price"><strong>{plan.price}</strong><span>{plan.cadence}</span></div>
          <h3>
            <span aria-hidden="true">
              {plan.featured
                ? <svg viewBox="0 0 24 24"><rect x="4" y="5.5" width="16" height="14" rx="2" /><path d="M8 3.5v4M16 3.5v4M4 10h16M8 14h3M8 17h6" /></svg>
                : plan.name.startsWith('Renewable') ? '↻' : '✓'}
            </span>
            {plan.name}
          </h3>
          <p>{plan.description}</p>
          <a class="plan-button" href={links.register}>Get started</a>
          <ul>{plan.features.map((feature) => <li><i aria-hidden="true">✓</i>{feature}</li>)}</ul>
        </article>
      ))}
    </div>
    <div class="payment-methods">
      <p>Buy credits using a wide variety of payment methods</p>
      <PaymentMarks />
    </div>
  </div>
</section>

<style>
  .pricing { position: relative; overflow: hidden; padding: clamp(4rem, 8vw, 6.6rem) 0 clamp(4.4rem, 8vw, 6.9rem); color: white; background: linear-gradient(180deg, #0f172b, #070d1a); scroll-margin-top: var(--header-height); }
  .pricing-inner { position: relative; }
  .pricing-head { max-width: 44rem; margin: 0 auto clamp(2.4rem, 5vw, 3.65rem); text-align: center; }
  h2 { margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; } h2 em { color: #38d3ff; font-style: normal; }
  .pricing-head p { margin: .95rem auto 0; color: #a9bcd8; font-size: clamp(.94rem, 1.15vw, 1.1rem); line-height: 1.6; }
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); align-items: stretch; gap: clamp(1rem, 2vw, 1.63rem); }
  .plan { position: relative; display: flex; flex-direction: column; height: 100%; padding: 1.63rem 1.5rem 1.75rem; color: #0f172b; background: white; border-radius: 1.38rem; box-shadow: 0 1.5rem 3.1rem -1.75rem rgb(0 0 0 / 85%); transition: 350ms cubic-bezier(.22,1,.36,1); }
  .plan:hover { box-shadow: 0 2.1rem 3.75rem -1.75rem rgb(0 0 0 / 90%); transform: translateY(-5px); }
  .plan.featured { color: white; background: linear-gradient(170deg, #0b3f63, #06263f); box-shadow: 0 1.9rem 3.75rem -1.6rem rgb(0 0 0 / 95%), 0 0 0 1px rgb(56 211 255 / 35%); }
  .featured-flag { position: absolute; top: -.8rem; left: 50%; padding: .38rem .94rem; color: white; background: linear-gradient(135deg, #1e8fd6, #0069a8); border-radius: 999px; box-shadow: 0 .5rem 1.25rem -.5rem rgb(30 143 214 / 90%); font-size: .72rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; transform: translateX(-50%); white-space: nowrap; }
  .starting { color: #7a8ba3; font-size: .84rem; }.featured .starting { color: #9dc4dd; }
  .price { display: flex; align-items: baseline; gap: .5rem; margin-top: .13rem; }.price strong { font-size: clamp(2.1rem, 3.6vw, 2.75rem); letter-spacing: -.03em; line-height: 1; }.price span { color: #7a8ba3; font-size: .94rem; }.featured .price span { color: #9dc4dd; }
  h3 { display: flex; align-items: center; gap: .63rem; margin: 1.25rem 0 0; font-size: 1.03rem; } h3 span { display: grid; place-items: center; flex: 0 0 2.13rem; width: 2.13rem; height: 2.13rem; color: #0069a8; background: rgb(0 105 168 / 10%); border: 1px solid rgb(0 105 168 / 22%); border-radius: .63rem; }.featured h3 span { color: #38d3ff; background: rgb(56 211 255 / 14%); border-color: rgb(56 211 255 / 35%); } h3 svg { width: 1.15rem; height: 1.15rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .plan > p { margin: .75rem 0 0; color: #5b6b82; font-size: .88rem; line-height: 1.6; }.plan.featured > p { color: #bcd4e6; }
  .plan-button { display: grid; place-items: center; width: 100%; min-height: 2.5rem; margin-top: 1.25rem; padding: .8rem 1.25rem; color: white; background: #0f172b; border-radius: 999px; font-size: .94rem; font-weight: 700; transition: transform 180ms ease; }.plan-button:active { transform: scale(.96); }.featured .plan-button { color: #0f172b; background: white; }
  ul { display: grid; gap: .69rem; margin: 1.25rem 0 0; padding: 0; list-style: none; } li { display: flex; gap: .63rem; color: #41506a; font-size: .86rem; line-height: 1.45; }.featured li { color: #cfe2f0; } li i { display: grid; place-items: center; flex: 0 0 1rem; height: 1rem; margin-top: .1rem; color: white; background: #0069a8; border-radius: 50%; font-size: .6rem; font-style: normal; }.featured li i { color: #06263f; background: #38d3ff; }
  .payment-methods { margin-top: clamp(2.75rem, 5.5vw, 4.25rem); text-align: center; }.payment-methods p { margin: 0 0 1.25rem; color: #a9bcd8; font-size: .91rem; }
  .hexagon { position: absolute; width: min(30rem, 34vw); aspect-ratio: 1; border: .45rem solid rgb(30 143 214 / 50%); border-radius: 28%; transform: rotate(30deg); }.hexagon-left { top: -8%; left: -10%; }.hexagon-right { right: -9%; bottom: -10%; }
  @media (max-width: 940px) { .plans { grid-template-columns: 1fr; max-width: 32.5rem; margin-inline: auto; }.plan.featured { order: -1; } }
  @media (max-width: 640px) { .hexagon { display: none; } }
</style>
