---
import { getEntry } from 'astro:content';
import { links } from '../config/links';
import Swoosh from './Swoosh.astro';

const page = await getEntry('home', 'home');
if (!page) throw new Error('src/content/pages/home.yaml is missing');
const { offer } = page.data;
/* three cards, three demo panels — the pairing is layout, the copy is not */
const [verifyCard, secureCard, automateCard] = offer.cards;

const serviceIcons = [
  { name: 'Instagram', paths: ['M7.6 2h8.8A5.6 5.6 0 0122 7.6v8.8a5.6 5.6 0 01-5.6 5.6H7.6A5.6 5.6 0 012 16.4V7.6A5.6 5.6 0 017.6 2zm0 2A3.6 3.6 0 004 7.6v8.8A3.6 3.6 0 007.6 20h8.8a3.6 3.6 0 003.6-3.6V7.6A3.6 3.6 0 0016.4 4H7.6z', 'M12 6.9a5.1 5.1 0 110 10.2 5.1 5.1 0 010-10.2zm0 2a3.1 3.1 0 100 6.2 3.1 3.1 0 000-6.2z', 'M17.5 5.2a1.35 1.35 0 110 2.7 1.35 1.35 0 010-2.7z'] },
  { name: 'WhatsApp', paths: ['M12 2a10 10 0 00-8.53 15.24L2 22.5l5.4-1.42A10 10 0 1012 2zm0 1.9a8.1 8.1 0 11-4.2 15.03l-.34-.2-2.9.76.78-2.83-.22-.36A8.1 8.1 0 0112 3.9z', 'M9.2 7.5c-.2-.44-.4-.45-.6-.46H8c-.18 0-.47.07-.72.34s-.94.92-.94 2.24.96 2.6 1.1 2.78c.13.18 1.86 2.97 4.58 4.05 2.27.9 2.74.72 3.23.67.5-.05 1.6-.65 1.82-1.28.23-.63.23-1.17.16-1.28-.07-.11-.25-.18-.52-.31s-1.6-.79-1.84-.88c-.25-.09-.43-.13-.6.14-.18.27-.69.87-.85 1.05-.15.18-.31.2-.58.07-.27-.13-1.14-.42-2.16-1.33-.8-.71-1.34-1.59-1.5-1.86-.15-.27-.01-.42.12-.55.12-.12.27-.31.4-.47.14-.16.18-.27.27-.45.09-.18.05-.34-.02-.47-.07-.14-.6-1.43-.83-1.96z'] },
  { name: 'Tinder', paths: ['M11.3 2.13c.2-.2.55-.06.55.23 0 2.5 1.13 4.4 2.85 5.66.1-.72.35-1.6.83-2.28.16-.22.5-.2.63.04 1.13 2.1 3.34 4.3 3.34 8.05 0 4.3-3.42 8.03-7.5 8.03S4.5 18.13 4.5 13.83c0-5.5 4.06-9.3 6.8-11.7z'] },
  { name: 'PayPal', paths: ['M15.607 4.653H8.941L6.645 19.251H1.82L4.862 0h7.995c3.754 0 6.375 2.294 6.473 5.513-.648-.478-2.105-.86-3.722-.86m6.57 5.546c0 3.41-3.01 6.853-6.958 6.853h-2.493L11.595 24H6.74l1.845-11.538h3.592c4.208 0 7.346-3.634 7.153-6.949a5.24 5.24 0 012.848 4.686M9.653 5.546h6.408c.907 0 1.942.222 2.363.541-.195 2.741-2.655 5.483-6.441 5.483H8.714Z'] },
  { name: 'Discord', paths: ['M20.317 4.37a19.79 19.79 0 00-4.885-1.515.074.074 0 00-.079.037c-.211.375-.445.865-.608 1.25a18.27 18.27 0 00-5.487 0c-.164-.394-.406-.875-.618-1.25a.077.077 0 00-.078-.037A19.74 19.74 0 003.677 4.37a.07.07 0 00-.032.028C.533 9.046-.319 13.58.099 18.058a.082.082 0 00.031.056c2.053 1.508 4.042 2.423 5.993 3.03a.078.078 0 00.084-.028c.462-.63.873-1.295 1.226-1.994a.076.076 0 00-.042-.106 12.3 12.3 0 01-1.872-.892.077.077 0 01-.008-.128c.126-.094.252-.192.373-.291a.074.074 0 01.077-.011c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.099.246.198.373.292a.077.077 0 01-.007.128c-.598.343-1.22.645-1.873.891a.077.077 0 00-.04.107c.36.698.771 1.363 1.224 1.993a.076.076 0 00.084.029c1.961-.607 3.95-1.522 6.003-3.03a.077.077 0 00.031-.055c.5-5.177-.838-9.674-3.548-13.66a.061.061 0 00-.031-.029zM8.02 15.331c-1.183 0-2.157-1.086-2.157-2.419s.956-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.419 0 1.333-.956 2.419-2.157 2.419zm7.975 0c-1.183 0-2.157-1.086-2.157-2.419s.955-2.419 2.157-2.419c1.21 0 2.176 1.095 2.157 2.419 0 1.333-.946 2.419-2.157 2.419z'] },
  { name: 'Telegram', paths: ['M21.9 3.4 2.5 10.9c-.72.28-.7 1.3.03 1.55l4.9 1.53 1.86 5.85c.19.6.95.78 1.39.33l2.6-2.62 4.86 3.57c.5.37 1.22.1 1.37-.5l3.9-15.9c.16-.66-.5-1.22-1.11-.99zM9.3 14.4l8.9-6.28-7.42 7.85-.36 3.3-1.12-4.87z'] },
  { name: 'Google', paths: ['M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z'] },
  { name: 'Amazon', paths: ['M14.1 10.6c0 1.1.03 2.02-.53 3-.45.8-1.17 1.29-1.96 1.29-1.09 0-1.73-.83-1.73-2.06 0-2.43 2.18-2.87 4.22-2.87v.64zm2.84 6.87a.59.59 0 01-.66.07c-.94-.78-1.1-1.14-1.62-1.88-1.54 1.57-2.63 2.04-4.63 2.04-2.36 0-4.2-1.46-4.2-4.37 0-2.28 1.23-3.83 2.99-4.58 1.52-.67 3.65-.79 5.28-.97v-.36c0-.66.05-1.44-.34-2.01-.34-.51-.98-.72-1.55-.72-1.06 0-2 .54-2.23 1.66-.05.25-.23.5-.48.51l-2.7-.29c-.23-.05-.48-.23-.41-.58.62-3.27 3.57-4.26 6.22-4.26 1.35 0 3.12.36 4.19 1.39 1.35 1.26 1.22 2.95 1.22 4.79v4.34c0 1.3.54 1.87 1.05 2.58.18.25.22.55-.01.74-.57.47-1.58 1.35-2.13 1.85z'] },
];
---

<section class="offer" id="offer" aria-labelledby="offer-heading">
  <div class="offer-inner shell">
    <header class="offer-head">
      <h2 id="offer-heading">{offer.headingPre} <span class="mark"><em>{offer.markEm}</em><Swoosh ink /></span></h2>
      <p>{offer.lede}</p>
    </header>

    <div class="offer-grid">
      <article class="offer-card" data-offer-card>
        <div class="offer-demo">
          <div class="service-grid" data-service-grid>
            {serviceIcons.map((icon) => (
              <span class:list={['service-tile', `service-${icon.name.toLowerCase()}`]} role="img" aria-label={icon.name}>
                <svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd" aria-hidden="true">
                  {icon.paths.map((path) => <path d={path} />)}
                  {icon.name === 'Amazon' && <path class="amazon-smile" d="M3.7 18.2c4.5 3.1 11 3.35 16 .35m-2.7-.7 3 .25-.9 2.55" />}
                </svg>
                <i aria-hidden="true"><svg viewBox="0 0 12 12"><path d="M2.6 6.4 5 8.8l4.4-5.4" /></svg></i>
              </span>
            ))}
          </div>
          <div class="modes"><span>SMS</span><span>Voice</span></div>
        </div>
        <div class="offer-body">
          <span class="offer-tag">{verifyCard.tag}</span>
          <h3>{verifyCard.title}</h3>
          <p>{verifyCard.body}</p>
          <a class="offer-link" href={links[verifyCard.link]}>Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="offer-card" data-offer-card>
        <div class="offer-demo privacy-demo" data-privacy-demo>
          <div class="number-card" data-personal-row><span>Your number</span><strong data-personal-number>+1 (312) 448-9071</strong></div>
          <div class="number-card" data-safe-row><span>What you hand over</span><strong>+1 (415) 555-0142</strong></div>
          <div class="privacy-badge" data-privacy-badge><span aria-hidden="true">✓</span> Your real number is never shared</div>
        </div>
        <div class="offer-body">
          <span class="offer-tag">{secureCard.tag}</span>
          <h3>{secureCard.title}</h3>
          <p>{secureCard.body}</p>
          <a class="offer-link" href={links[secureCard.link]}>Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>

      <article class="offer-card" data-offer-card>
        <div class="offer-demo">
          <div class="terminal" data-terminal-demo>
            <div class="terminal-bar"><i></i><i></i><i></i></div>
            <pre><code data-terminal></code></pre>
          </div>
        </div>
        <div class="offer-body">
          <span class="offer-tag">{automateCard.tag}</span>
          <h3>{automateCard.title}</h3>
          <p>{automateCard.body}</p>
          <a class="offer-link" href={links[automateCard.link]}>Learn more <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  import { prefersReducedMotion, runWhileVisible, wait } from '../scripts/demo';

  const reducedMotion = prefersReducedMotion();

  document.querySelectorAll<HTMLElement>('[data-offer-card]').forEach((card) => {
    if (reducedMotion || !('IntersectionObserver' in window)) card.classList.add('visible');
    else new IntersectionObserver(([entry], observer) => {
      if (!entry.isIntersecting) return;
      card.classList.add('visible');
      observer.unobserve(card);
    }, { threshold: .2 }).observe(card);

  });

  document.querySelectorAll<HTMLElement>('[data-service-grid]').forEach((grid) => {
    const tiles = [...grid.querySelectorAll<HTMLElement>('.service-tile')];
    if (reducedMotion) { tiles.forEach((tile) => tile.classList.add('verified')); return; }
    runWhileVisible(grid, async (stopped) => {
      while (!stopped()) {
        for (let index = 0; index < tiles.length; index++) {
          if (stopped()) return;
          tiles[index].classList.add('verified');
          await wait(340);
        }
        await wait(1100);
        tiles.forEach((tile) => tile.classList.remove('verified'));
        await wait(500);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-privacy-demo]').forEach((demo) => {
    const number = demo.querySelector<HTMLElement>('[data-personal-number]');
    const personalRow = demo.querySelector<HTMLElement>('[data-personal-row]');
    const safeRow = demo.querySelector<HTMLElement>('[data-safe-row]');
    const badge = demo.querySelector<HTMLElement>('[data-privacy-badge]');
    const realNumber = '+1 (312) 448-9071';
    /* stop short of the +1 — the country code isn't private */
    const digitCount = realNumber.replace(/\D/g, '').length - 1;
    const maskTo = (count: number) => {
      let masked = 0;
      return realNumber.split('').reverse().map((character) => {
        if (/\d/.test(character) && masked < count) {
          masked++;
          return '•';
        }
        return character;
      }).reverse().join('');
    };
    if (reducedMotion) { if (number) number.textContent = maskTo(digitCount); personalRow?.classList.add('masked'); safeRow?.classList.add('provided'); badge?.classList.add('visible'); return; }
    runWhileVisible(demo, async (stopped) => {
      while (!stopped()) {
        if (number) number.textContent = realNumber;
        personalRow?.classList.remove('masked'); safeRow?.classList.remove('provided'); badge?.classList.remove('visible');
        await wait(900);
        for (let count = 1; count <= digitCount; count++) {
          if (stopped()) return;
          if (number) number.textContent = maskTo(count);
          if (count === 1) personalRow?.classList.add('masked');
          await wait(85);
        }
        await wait(300); safeRow?.classList.add('provided');
        await wait(250); badge?.classList.add('visible');
        await wait(2600);
      }
    });
  });

  const terminalTokens = [
    { text: '$ curl https://api.textverified.com/api/pub/v2/verifications\n\n', className: 'terminal-command' },
    { text: '{\n  "number": ', className: '' }, { text: '"+14155550142"', className: 'terminal-string' },
    { text: ',\n  "code": ', className: '' }, { text: '"481209"', className: 'terminal-string' },
    { text: ',\n  "status": ', className: '' }, { text: '"completed"', className: 'terminal-string' },
    { text: '\n}\n', className: '' },
  ];
  const terminalLength = terminalTokens.reduce((total, token) => total + token.text.length, 0);
  const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const terminalMarkup = (length: number) => {
    let used = 0;
    let output = '';
    for (const token of terminalTokens) {
      if (used >= length) break;
      const text = token.text.slice(0, Math.max(0, length - used));
      output += token.className ? `<span class="${token.className}">${escapeHtml(text)}</span>` : escapeHtml(text);
      used += token.text.length;
    }
    return `${output}<span class="terminal-caret"></span>`;
  };
  document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((terminal) => {
    if (reducedMotion) { terminal.innerHTML = terminalMarkup(terminalLength); return; }
    runWhileVisible(terminal, async (stopped) => {
      while (!stopped()) {
        for (let length = 0; length <= terminalLength; length += 2) {
          if (stopped()) return;
          terminal.innerHTML = terminalMarkup(length);
          await wait(18);
        }
        await wait(3200);
        terminal.innerHTML = terminalMarkup(0);
        await wait(500);
      }
    });
  });
</script>

<style>
  .offer { position: relative; padding: clamp(4.1rem, 8vw, 7rem) 0 clamp(4.5rem, 9vw, 7.5rem); color: #0f172b; background: linear-gradient(180deg, white, #f2f5f9); scroll-margin-top: var(--header-height); }
  .offer-head { max-width: 45rem; margin: 0 auto clamp(2.5rem, 5vw, 3.9rem); text-align: center; }
  h2 { margin: 0; font-size: clamp(1.9rem, 3.6vw, 2.9rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.15; }
  h2 em { color: #0069a8; font-style: normal; }
  .offer-head p { margin: 1rem auto 0; color: #54637a; font-size: clamp(.94rem, 1.15vw, 1.1rem); line-height: 1.6; }
  .offer-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.1rem, 2.2vw, 1.75rem); }
  .offer-card { position: relative; display: flex; flex-direction: column; overflow: hidden; background: white; border: 1px solid rgb(15 23 43 / 9%); border-radius: 1.25rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.1rem 2.5rem -1.75rem rgb(15 23 43 / 50%); opacity: 0; transform: translateY(1.6rem); transition: opacity 700ms cubic-bezier(.22,1,.36,1), transform 700ms cubic-bezier(.22,1,.36,1), box-shadow 350ms ease, border-color 350ms ease; }
  .offer-card.visible { opacity: 1; transform: none; }.offer-card:nth-child(2) { transition-delay: 100ms; }.offer-card:nth-child(3) { transition-delay: 200ms; }
  .offer-card:hover { border-color: rgb(0 105 168 / 35%); box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1.6rem 3.1rem -1.6rem rgb(15 23 43 / 55%); }
  .offer-demo { position: relative; height: 14.25rem; padding: 1.1rem; overflow: hidden; background: #f4f7fb; border-bottom: 1px solid rgb(15 23 43 / 8%); }
  .offer-body { display: flex; flex: 1; flex-direction: column; padding: 1.38rem 1.38rem 1.5rem; }
  .offer-tag { color: #0069a8; font-size: .78rem; font-weight: 800; letter-spacing: .02em; }
  h3 { margin: .62rem 0 0; font-size: clamp(1.13rem, 1.5vw, 1.32rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.25; }
  .offer-body p { margin: .62rem 0 0; color: #5b6b82; font-size: .88rem; line-height: 1.6; }
  .offer-link { display: inline-flex; align-items: center; align-self: flex-start; gap: .45rem; margin-top: auto; padding-top: 1.1rem; color: #0069a8; font-size: .88rem; font-weight: 700; }.offer-link span { transition: transform 300ms ease; }.offer-link:hover span { transform: translateX(.25rem); }
  .service-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .55rem; }
  .service-tile { position: relative; display: grid; place-items: center; height: 3.63rem; color: #8394ab; background: white; border: 1px solid rgb(15 23 43 / 10%); border-radius: .7rem; transition: 350ms cubic-bezier(.22,1,.36,1); }.service-tile svg { width: 1.25rem; height: 1.25rem; overflow: visible; }.service-amazon svg { width: 1.35rem; height: 1.35rem; transform: translateY(-.04rem); }.service-amazon .amazon-smile { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }.service-tile i { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: .95rem; height: .95rem; color: white; background: #16a365; border-radius: 50%; box-shadow: 0 0 0 2px #f4f7fb; transform: translate(40%, -40%) scale(0); transition: transform 300ms cubic-bezier(.22,1,.36,1); }
  /* a stroked check, not the font's ✓ glyph — the text mark rendered too thin
     to read at badge size */
  .service-tile i svg { width: .55rem; height: .55rem; fill: none; stroke: currentColor; stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; }.service-tile.verified { color: #16a365; background: #eafaf1; border-color: rgb(22 163 101 / 45%); transform: translateY(-2px); }.service-tile.verified i { transform: translate(40%, -40%) scale(1); }
  .modes { display: flex; gap: .55rem; margin-top: .75rem; }.modes span { min-width: 4.25rem; padding: .42rem .9rem; color: #0069a8; background: rgb(0 105 168 / 9%); border: 1px solid rgb(0 105 168 / 28%); border-radius: 999px; font-size: .78rem; font-weight: 800; text-align: center; }
  .privacy-demo { display: flex; flex-direction: column; justify-content: center; }
  .number-card { display: flex; align-items: center; gap: .6rem; padding: .82rem .88rem; background: white; border: 1px solid rgb(15 23 43 / 10%); border-radius: .82rem; transition: 400ms cubic-bezier(.22,1,.36,1); }.number-card + .number-card { margin-top: .7rem; }.number-card span { color: #8394ab; font-size: .68rem; font-weight: 800; letter-spacing: .07em; text-transform: uppercase; }.number-card strong { margin-left: auto; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .84rem; }.number-card.masked { background: #fdf2f2; border-color: rgb(200 60 60 / 28%); }.number-card.masked strong { color: #b64545; }.number-card.provided { background: #eafaf1; border-color: rgb(22 163 101 / 40%); }.number-card.provided strong { color: #0f8a55; }
  .privacy-badge { display: flex; align-items: center; gap: .38rem; margin-top: .75rem; color: #5b6b82; font-size: .78rem; font-weight: 700; opacity: 0; transform: translateY(.32rem); transition: 450ms cubic-bezier(.22,1,.36,1); }.privacy-badge.visible { color: #0f8a55; opacity: 1; transform: none; }.privacy-badge span { display: grid; place-items: center; width: 1.05rem; height: 1.05rem; color: white; background: #16a365; border-radius: 50%; font-size: .62rem; }
  .terminal { display: flex; flex-direction: column; height: 100%; overflow: hidden; background: #0d1726; border: 1px solid rgb(255 255 255 / 9%); border-radius: .75rem; }.terminal-bar { display: flex; gap: .38rem; padding: .56rem .7rem; border-bottom: 1px solid rgb(255 255 255 / 8%); }.terminal-bar i { width: .56rem; height: .56rem; background: #33465f; border-radius: 50%; }.terminal-bar i:first-child { background: #e0605c; }.terminal-bar i:nth-child(2) { background: #e2b34a; }.terminal-bar i:nth-child(3) { background: #4fbf6e; }.terminal pre { flex: 1; margin: 0; padding: .7rem .75rem; overflow: hidden; color: #cfe0f2; font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace; font-size: .72rem; line-height: 1.62; white-space: pre-wrap; word-break: break-word; }
  :global(.terminal-command) { color: #7fe0b0; }:global(.terminal-string) { color: #f5c97a; }:global(.terminal-caret) { display: inline-block; width: .38rem; height: .75rem; background: #7fe0b0; vertical-align: -.13rem; animation: terminal-blink 1s steps(1) infinite; }
  @keyframes terminal-blink { 50% { opacity: 0; } }
  @media (max-width: 940px) { .offer-grid { grid-template-columns: 1fr; max-width: 35rem; margin-inline: auto; }.offer-card { transition-delay: 0ms !important; } }
  @media (prefers-reduced-motion: reduce) { .offer-card { opacity: 1; transform: none; transition: none; }:global(.terminal-caret) { animation: none; } }
</style>
