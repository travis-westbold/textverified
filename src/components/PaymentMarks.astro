<style>
  .marks { display: grid; gap: 1.15rem; justify-items: center; }
  .cards, .coins { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; }
  .cards { gap: 1.6rem; }
  .coins { gap: .9rem; }
  /* the marks differ in aspect ratio, so height is set per brand to balance
     them optically rather than mathematically */
  .cards svg { width: auto; }
  [aria-label='Visa'] { height: 1.5rem; color: white; }
  [aria-label='Mastercard'] { height: 2.1rem; }
  [aria-label='American Express'] { height: 2.5rem; }
  .coins svg { width: 2.5rem; height: 2.5rem; }
  @media (max-width: 640px) {
    .cards { gap: 1.25rem; }
    [aria-label='Visa'] { height: 1.3rem; }
    [aria-label='Mastercard'] { height: 1.8rem; }
    [aria-label='American Express'] { height: 2.15rem; }
    .coins svg { width: 2.25rem; height: 2.25rem; }
  }
</style>
