---
import { getEntry } from 'astro:content';
import { links } from '../config/links';

interface Props {
  /** which top-level item this page is, for aria-current styling */
  current?: 'products' | 'faq';
}

const { current } = Astro.props;

/* Labels, details and destinations are org-editable; icons and the
   Overview-leads-full-width layout are developer-owned. */
const nav = await getEntry('navigation', 'navigation');
if (!nav) throw new Error('src/content/settings/navigation.yaml is missing');
const { productsMenu: products, mainNav: navigation } = nav.data;
---

<header class="site-header" data-header>
  <div class="nav shell">
    <a class="brand" href={links.home} aria-label="Textverified home">
      <img src="/tvlogo.svg" alt="Textverified" width="375" height="93" />
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <div class="products" data-products>
        <button class="nav-link products-trigger" type="button" aria-expanded="false" aria-current={current === 'products' ? 'page' : undefined}>
          Products <span class="chevron" aria-hidden="true"><svg viewBox="0 0 12 8"><path d="m1 1 5 5 5-5" /></svg></span>
        </button>
        <div class="products-menu" data-products-menu>
          {products.map((product) => (
            <a href={links[product.link]} class:list={['product-link', { lead: product.lead }]}>
              <span class="product-icon" aria-hidden="true">
                {product.icon === 'grid' && <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg>}
                {product.icon === 'message' && <svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></svg>}
                {product.icon === 'phone' && <svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2z" /></svg>}
                {product.icon === 'mobile' && <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="3" /><path d="M11 18h2" /></svg>}
                {product.icon === 'api' && <svg viewBox="0 0 24 24"><path d="M4 7h16M4 7l1.5 12.2a2 2 0 0 0 2 1.8h9a2 2 0 0 0 2-1.8L20 7M9 7V5a3 3 0 0 1 6 0v2" /></svg>}
              </span>
              <span><strong>{product.name}</strong><small>{product.detail}</small></span>
            </a>
          ))}
        </div>
      </div>
      {navigation.map((item) => <a class="nav-link" href={links[item.link]} aria-current={item.link === current ? 'page' : undefined}>{item.label}</a>)}
    </nav>

    <div class="nav-actions">
      <a class="button button-quiet desktop-action" href={links.signIn}>Sign in</a>
      <a class="button button-primary desktop-action" href={links.register}>Sign up</a>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" data-menu-toggle>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <a href={links.productsPage}>Products</a>
    {navigation.map((item) => <a href={links[item.link]}>{item.label}</a>)}
    <div class="mobile-actions">
      <a class="button button-outline" href={links.signIn}>Sign in</a>
      <a class="button button-primary" href={links.register}>Sign up free</a>
    </div>
  </nav>

  <span class="progress" data-progress aria-hidden="true"></span>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const progress = header?.querySelector<HTMLElement>('[data-progress]');
  const products = document.querySelector('[data-products]');
  const productsButton = products?.querySelector('button');
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileMenu = document.querySelector('[data-mobile-menu]');

  /* stuck shadow + scroll progress hairline */
  let frameRequested = false;
  let maxScroll = 0;
  const paint = () => {
    frameRequested = false;
    header?.classList.toggle('is-stuck', window.scrollY > 24);
    if (progress) progress.style.transform = `scaleX(${maxScroll > 0 ? window.scrollY / maxScroll : 0})`;
  };
  window.addEventListener('scroll', () => {
    if (frameRequested) return;
    frameRequested = true;
    window.requestAnimationFrame(paint);
  }, { passive: true });
  const measurePage = () => {
    maxScroll = document.documentElement.scrollHeight - window.innerHeight;
    paint();
  };
  window.addEventListener('resize', measurePage);
  new ResizeObserver(measurePage).observe(document.documentElement);
  measurePage();

  const closeProducts = () => {
    products?.removeAttribute('data-open');
    productsButton?.setAttribute('aria-expanded', 'false');
  };

  productsButton?.addEventListener('click', () => {
    const open = products?.toggleAttribute('data-open') ?? false;
    productsButton.setAttribute('aria-expanded', String(open));
  });

  menuButton?.addEventListener('click', () => {
    const open = mobileMenu?.toggleAttribute('data-open') ?? false;
    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });

  document.addEventListener('click', (event) => {
    if (products && !products.contains(event.target as Node)) closeProducts();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    closeProducts();
    mobileMenu?.removeAttribute('data-open');
    menuButton?.setAttribute('aria-expanded', 'false');
    menuButton?.focus();
  });
</script>

<style>
  /* solid white, no backdrop blur — the perf floor is low-end hardware */
  .site-header { position: fixed; inset: 0 0 auto; z-index: 30; height: var(--header-height); background: white; border-bottom: 1px solid rgb(15 23 42 / 8%); transition: box-shadow 350ms cubic-bezier(.22,1,.36,1); }
  .site-header.is-stuck { box-shadow: 0 12px 30px -14px rgb(15 23 43 / 32%); }
  .progress { position: absolute; left: 0; bottom: -1px; width: 100%; height: 2px; background: linear-gradient(90deg, var(--brand), #11b1ea, var(--cyan)); transform: scaleX(0); transform-origin: left; }
  .nav { height: 100%; display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.75rem); }
  .brand { display: flex; flex: 0 0 auto; }
  .brand img { width: 186px; height: auto; }
  .desktop-nav { display: flex; align-items: center; gap: .2rem; }
  .nav-link { position: relative; padding: .65rem .85rem; border-radius: 999px; color: var(--text-muted); font-size: .92rem; font-weight: 600; transition: color 180ms ease, background 180ms ease; }
  .nav-link:hover, .nav-link:focus-visible, .products[data-open] .nav-link { color: var(--text); background: var(--surface-subtle); }
  /* selected page reads as a tinted pill — the radius comes from .nav-link,
     so it stays a full pill rather than being reshaped */
  .nav-link[aria-current='page'] { color: var(--brand); background: var(--surface-blue); box-shadow: inset 0 0 0 1px var(--border-blue); }
  .nav-link[aria-current='page']:hover, .nav-link[aria-current='page']:focus-visible { background: var(--border-blue); }
  .products { position: relative; }
  .products-trigger { display: flex; align-items: center; gap: .35rem; border: 0; background: none; cursor: pointer; font-family: inherit; }
  .chevron { display: grid; place-items: center; flex: 0 0 .75rem; width: .75rem; height: .75rem; transition: transform 200ms ease; }
  .chevron svg { display: block; width: .7rem; height: .47rem; fill: none; stroke: currentColor; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }
  .products[data-open] .chevron { transform: rotate(180deg); }
  .products-menu { position: absolute; top: calc(100% + .8rem); left: -.6rem; width: min(34rem, 80vw); display: grid; grid-template-columns: 1fr 1fr; gap: .25rem; padding: .65rem; background: white; border: 1px solid var(--border); border-radius: 1.15rem; box-shadow: 0 24px 70px -28px rgb(15 23 42 / 45%); opacity: 0; visibility: hidden; transform: translateY(-.5rem) scale(.98); transform-origin: top left; transition: 180ms ease; }
  .products[data-open] .products-menu { opacity: 1; visibility: visible; transform: none; }
  .product-link { display: flex; gap: .75rem; padding: .75rem; border-radius: .8rem; }
  /* the Overview entry leads the panel full-width, so the four products
     below still pair up cleanly in the 2-column grid */
  .product-link.lead { grid-column: 1 / -1; border-bottom: 1px solid rgb(15 23 43 / 8%); border-radius: .8rem .8rem .25rem .25rem; margin-bottom: .15rem; }
  .product-link:hover { background: var(--surface-blue); }
  .product-icon { display: grid; place-items: center; flex: 0 0 2.25rem; height: 2.25rem; border-radius: .65rem; background: var(--surface-blue); border: 1px solid var(--border-blue); color: var(--brand); }
  .product-icon svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .product-link strong, .product-link small { display: block; }
  .product-link strong { color: var(--text); font-size: .88rem; }
  .product-link small { margin-top: .15rem; color: var(--text-muted); font-size: .74rem; line-height: 1.35; }
  /* the auto margin lives here, not on .desktop-nav — the nav is display:none
     under 960px and would take the right-justification with it */
  .nav-actions { display: flex; align-items: center; gap: .55rem; margin-left: auto; }
  .menu-toggle { display: none; position: relative; width: 2.75rem; height: 2.75rem; border: 0; border-radius: .75rem; background: transparent; cursor: pointer; }
  .menu-toggle span { position: absolute; left: .75rem; width: 1.25rem; height: 2px; border-radius: 1rem; background: var(--text); transition: 200ms ease; }
  .menu-toggle span:nth-child(1) { top: .95rem; }.menu-toggle span:nth-child(2) { top: 1.35rem; }.menu-toggle span:nth-child(3) { top: 1.75rem; }
  .menu-toggle[aria-expanded='true'] span:nth-child(1) { top: 1.35rem; transform: rotate(45deg); }.menu-toggle[aria-expanded='true'] span:nth-child(2) { opacity: 0; }.menu-toggle[aria-expanded='true'] span:nth-child(3) { top: 1.35rem; transform: rotate(-45deg); }
  .mobile-menu { display: none; position: absolute; inset: var(--header-height) 0 auto; padding: 1rem 4vw 1.4rem; background: white; border-bottom: 1px solid var(--border); box-shadow: 0 24px 40px -30px rgb(15 23 42 / 45%); }
  .mobile-menu > a { padding: .85rem .25rem; color: var(--text); font-weight: 600; border-bottom: 1px solid var(--border); }
  .mobile-actions { display: grid; grid-template-columns: 1fr 1fr; gap: .7rem; margin-top: 1rem; }
  @media (max-width: 960px) { .desktop-nav { display: none; }.menu-toggle { display: block; }.mobile-menu[data-open] { display: grid; } }
  /* actions shed one at a time as width tightens: sign-up goes first, sign-in
     holds on until 400px, the hamburger always rides the right edge (both
     buttons stay reachable inside the mobile menu) */
  @media (max-width: 560px) { .site-header { --header-height: 4.5rem; }.brand img { width: 158px; }.desktop-action.button-primary { display: none; } }
  @media (max-width: 400px) { .desktop-action { display: none; } }
</style>
