---
/* The brand underline: a hand-drawn stroke anchored to the words it
   emphasises. Wrap a short phrase in <span class="mark">…<Swoosh /></span>;
   the stroke draws itself the first time it scrolls into view. Pass `ink`
   on light backgrounds. */
interface Props {
  ink?: boolean;
}

const { ink = false } = Astro.props;
---

<svg class:list={['swoosh', { ink }]} viewBox="0 0 420 22" preserveAspectRatio="none" aria-hidden="true">
  <path d="M6 15C74 6 160 3 246 6c58 2 108 6 168 9-52-2-104-1-156 2"></path>
</svg>

<script>
  const marks = document.querySelectorAll('.mark');
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
    marks.forEach((mark) => mark.classList.add('drawn'));
  } else {
    const observer = new IntersectionObserver((entries, obs) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('drawn');
      obs.unobserve(entry.target);
    }), { threshold: 0.6 });
    marks.forEach((mark) => observer.observe(mark));
  }
</script>

<style is:global>
  .mark { position: relative; display: inline-block; }
  .swoosh { position: absolute; left: -2.5%; bottom: -.32em; width: 105%; height: .3em; overflow: visible; color: #11b1ea; pointer-events: none; }
  .swoosh path { fill: none; stroke: currentColor; stroke-width: 6; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 640; stroke-dashoffset: 640; filter: drop-shadow(0 0 10px rgb(17 177 234 / 70%)); }
  .mark.drawn .swoosh path { animation: swoosh-draw 1.1s cubic-bezier(.22,1,.36,1) forwards; }
  .swoosh.ink { color: #0069a8; }
  .swoosh.ink path { filter: none; stroke-width: 5; }
  @keyframes swoosh-draw { to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .swoosh path { stroke-dashoffset: 0; } }
</style>
