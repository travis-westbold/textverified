---
import { links } from '../config/links';

/* The blue closing band. Defaults are the homepage copy; the products page
   passes its own. */
interface Props {
  heading?: string;
  body?: string;
  buttonLabel?: string;
}

const {
  heading = 'Get started today',
  body = 'Sign-up is quick, free and easy. We respect your privacy. Your account will be ready to use within minutes.',
  buttonLabel = 'Sign up now',
} = Astro.props;
---

<section class="signup-cta" aria-labelledby="signup-heading">
  <span class="hexagon left" aria-hidden="true"></span><span class="hexagon right" aria-hidden="true"></span>
  <div class="shell signup-inner">
    <h2 id="signup-heading">{heading}</h2>
    <p>{body}</p>
    <a class="button signup-button" href={links.register}>{buttonLabel}</a>
  </div>
</section>

<style>
  .signup-cta { position: relative; overflow: hidden; padding: clamp(3.4rem, 6.5vw, 5.5rem) 0; color: white; background: linear-gradient(112deg, #3358ef, #2f7fe8 42%, #25a6f2); text-align: center; }
  .signup-cta::before { content: ''; position: absolute; inset: 0; background: radial-gradient(60% 90% at 18% 100%, rgb(150 120 255 / 55%), transparent 62%); pointer-events: none; }
  .signup-inner { position: relative; }
  h2 { margin: 0; font-size: clamp(1.75rem, 3.4vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; }
  p { max-width: 52ch; margin: .9rem auto 0; color: rgb(255 255 255 / 92%); font-size: clamp(.94rem, 1.15vw, 1.1rem); line-height: 1.6; }
  .signup-button { margin-top: 1.6rem; padding: .94rem 2.1rem; color: #0f172b; background: white; box-shadow: 0 .9rem 1.9rem -.75rem rgb(0 0 0 / 40%); }
  .hexagon { position: absolute; width: min(27rem, 34vw); aspect-ratio: 1; border: .55rem solid rgb(255 255 255 / 20%); border-radius: 28%; transform: rotate(30deg); }.hexagon.left { top: 12%; left: -9%; }.hexagon.right { top: -45%; right: -7%; }
  @media (max-width: 640px) { .hexagon { display: none; } }
</style>
