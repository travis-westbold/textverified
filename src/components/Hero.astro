---
import { getEntry } from 'astro:content';
import VerificationCard from './VerificationCard.astro';
import IsoField from './IsoField.astro';
import Swoosh from './Swoosh.astro';
import { links } from '../config/links';

const page = await getEntry('home', 'home');
if (!page) throw new Error('src/content/pages/home.yaml is missing');
const { hero } = page.data;
---

<section class="hero" aria-labelledby="hero-title" data-animated-section data-reveal>
  <div class="aurora" aria-hidden="true"></div>
  <IsoField side="left" />
  <IsoField side="right" />

  <div class="hero-grid shell">
    <div class="hero-copy">
      <p class="eyebrow up"><span></span> {hero.eyebrow}</p>
      <h1 id="hero-title" class="up">
        {hero.title}
        <strong>{hero.strongPre} <span class="mark">{hero.mark.pre} <em>{hero.mark.em}</em><Swoosh /></span></strong>
      </h1>
      <p class="lede up">{hero.lede}</p>
      <div class="hero-actions up">
        <a class="button button-primary button-large" href={links.register}>{hero.primaryCta} <span aria-hidden="true">→</span></a>
        <a class="button button-inverse" href={links.signIn}>{hero.signInCta}</a>
        <a class="learn-link" href={links.productsPage}><span class="play" aria-hidden="true">▶</span> {hero.learnCta}</a>
      </div>
    </div>

    <div class="hero-visual up">
      <VerificationCard />
    </div>
  </div>

  <div class="trust">
    <div class="trust-inner shell">
      <p>{hero.trustLabel}</p>
      <div class="marquee">
        <div class="platforms" aria-label="Supported platforms">
          {hero.platforms.map((platform) => <span>{platform}</span>)}
          {hero.platforms.map((platform) => <span aria-hidden="true">{platform}</span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  /* ambient animation (the eyebrow dot) sleeps while the hero is off-screen —
     [data-animation-state='paused'] is defined globally. The platform strip is
     scroll-linked and needs no pausing: it only advances while on screen. */
  document.querySelectorAll<HTMLElement>('[data-animated-section]').forEach((section) => {
    if (!('IntersectionObserver' in window)) return;
    new IntersectionObserver(([entry]) => {
      section.dataset.animationState = entry.isIntersecting ? 'running' : 'paused';
    }).observe(section);
  });

  /* entrance choreography: rAF alone never fires in a backgrounded tab,
     which would leave the hero blank until focus — belt and braces */
  const reveal = () => document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('revealed'));
  window.requestAnimationFrame(reveal);
  window.setTimeout(reveal, 60);
</script>

<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--header-height) + clamp(2.4rem, 4.6vw, 4.25rem)) 0 0; color: white; background: radial-gradient(120% 80% at 50% -10%, #1a2c4d 0%, transparent 55%), linear-gradient(180deg, #0f172b 0%, #070d1a 100%); }
  .hero-grid { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.06fr) minmax(0, .94fr); align-items: center; gap: clamp(2.1rem, 5vw, 4.5rem); padding-bottom: clamp(2.9rem, 5.5vw, 4.75rem); }
  .hero-copy { position: relative; }
  /* legibility scrim so the tile field never fights the headline */
  .hero-copy::before { content: ''; position: absolute; z-index: -1; inset: -14% -22% -14% -30%; background: radial-gradient(58% 52% at 42% 50%, rgb(7 13 26 / 92%) 0%, rgb(7 13 26 / 60%) 52%, transparent 78%); pointer-events: none; }
  .eyebrow { display: inline-flex; align-items: center; gap: .65rem; margin: 0 0 1.35rem; padding: .45rem .9rem .45rem .65rem; color: #beeefe; background: rgb(17 177 234 / 10%); border: 1px solid rgb(56 211 255 / 28%); border-radius: 999px; font-size: .78rem; font-weight: 700; letter-spacing: .015em; }
  .eyebrow span { position: relative; width: .5rem; height: .5rem; background: #37e0a0; border-radius: 50%; }
  .eyebrow span::after { content: ''; position: absolute; inset: 0; background: #37e0a0; border-radius: 50%; animation: hero-ping 2s ease-out infinite; }
  h1 { margin: 0; font-size: clamp(2.125rem, 3.95vw, 3.3125rem); font-weight: 800; line-height: 1.1; letter-spacing: -.03em; text-wrap: balance; }
  h1 strong { display: block; margin-top: .16em; color: white; font-weight: 800; }
  h1 em { color: #38d3ff; font-style: normal; white-space: nowrap; }
  /* let the headline land before the underline draws */
  .hero :global(.mark.drawn .swoosh path) { animation-delay: .55s; }
  .lede { max-width: 43ch; margin: 1.625rem 0 0; color: #a9bcd8; font-size: clamp(.94rem, 1.15vw, 1.0625rem); line-height: 1.7; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
  .learn-link { display: inline-flex; align-items: center; gap: .55rem; padding: .65rem .7rem; color: #d8e7f7; font-size: .85rem; font-weight: 700; }
  .play { display: grid; place-items: center; width: 2rem; height: 2rem; padding-left: .1rem; color: #38d3ff; background: rgb(17 177 234 / 16%); border: 1px solid rgb(17 177 234 / 45%); border-radius: 50%; font-size: .6rem; }
  .hero-visual { display: flex; justify-content: center; }

  /* static aurora: soft-edged gradients, no drift — the slow animation kept
     three huge GPU layers compositing forever on low-end hardware */
  .aurora { position: absolute; z-index: -3; inset: -20%; opacity: .32; pointer-events: none; background: radial-gradient(circle at 20% 25%, #0a5f96, transparent 32%), radial-gradient(circle at 82% 22%, #0e7fb8, transparent 32%), radial-gradient(circle at 52% 82%, #134a7a, transparent 34%); }

  .trust { position: relative; z-index: 2; padding: 1.9rem 0 2rem; background: #eef0f3; }
  .trust p { margin: 0 0 .9rem; color: #6b7482; font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-align: center; text-transform: uppercase; }
  .marquee { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .platforms { display: flex; align-items: center; gap: clamp(2.1rem, 5vw, 4rem); width: max-content; color: #39424f; }
  /* the strip advances with the page scroll instead of on a timer. The view
     timeline is named on .trust because .marquee is overflow:hidden, which
     makes it a scroll container and would capture a bare view(). Where
     scroll-driven animations are unsupported the strip simply stands still —
     never falling back to ambient motion. */
  @supports (animation-timeline: view()) {
    .trust { view-timeline: --platform-strip block; }
    .platforms { animation: marquee-slide linear both; animation-timeline: --platform-strip; animation-range: entry 0% exit 100%; }
  }
  .platforms span { font-size: clamp(1.05rem, 1.65vw, 1.38rem); font-weight: 700; letter-spacing: -.01em; opacity: .82; white-space: nowrap; }

  /* entrance choreography */
  .up { opacity: 0; transform: translateY(1.5rem); transition: opacity 800ms cubic-bezier(.22,1,.36,1), transform 800ms cubic-bezier(.22,1,.36,1); }
  :global(.revealed) .up { opacity: 1; transform: none; }
  .eyebrow.up { transition-delay: 50ms; }
  h1.up { transition-delay: 150ms; }
  .lede.up { transition-delay: 280ms; }
  .hero-actions.up { transition-delay: 400ms; }
  .hero-visual.up { transition-delay: 300ms; }

  @keyframes hero-ping { 0% { transform: scale(1); opacity: .8; } 100% { transform: scale(3.2); opacity: 0; } }
  @keyframes marquee-slide { to { transform: translateX(-50%); } }

  @media (max-width: 940px) {
    .hero-grid { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .hero-copy::before { inset: -12% -20%; }
    .lede { max-width: 58ch; }
    .hero-actions { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; } .platforms, .eyebrow span::after { animation: none; } }
  /* data-saver tier: the strip stands still (its brands remain readable) */
  @media (prefers-reduced-data: reduce) { .platforms { animation: none; } }
</style>
