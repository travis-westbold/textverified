---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupCta from '../components/SignupCta.astro';
import Swoosh from '../components/Swoosh.astro';
import ProductHero from '../components/products/ProductHero.astro';
import Laptop from '../components/Laptop.astro';
import Monitor from '../components/Monitor.astro';
import ProductSection from '../components/products/ProductSection.astro';
import ExtrasGrid from '../components/products/ExtrasGrid.astro';
import UseCases from '../components/products/UseCases.astro';
import PlanCompare from '../components/products/PlanCompare.astro';
import RentalSetupScreen from '../components/products/RentalSetupScreen.astro';
import RentalsScreen from '../components/products/RentalsScreen.astro';
import { links } from '../config/links';

const page = await getEntry('rentals', 'rentals');
if (!page) throw new Error('src/content/pages/rentals.yaml is missing');
const { meta, hero, sections, useCases, extras, planCompare, signupCta } = page.data;

const section = (id: (typeof sections)[number]['id']) => {
  const found = sections.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`rentals.yaml is missing the "${id}" section`);
  return found;
};

const sectionProps = (id: (typeof sections)[number]['id']) => {
  const data = section(id);
  return {
    id: data.id,
    kicker: data.kicker,
    tone: data.tone,
    flip: data.flip,
    lede: data.lede,
    steps: data.steps,
    primaryLabel: data.primaryLabel,
    primaryHref: data.primaryLink ? links[data.primaryLink] : undefined,
    secondaryLabel: data.secondaryLabel,
    secondaryHref: data.secondaryLink ? links[data.secondaryLink] : undefined,
  };
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Header current="products" />
  <main>
    <ProductHero
      id="rentals"
      kicker={hero.kicker}
      title={hero.title}
      mark={hero.mark}
      lede={hero.lede}
      primaryLabel={hero.primaryCta}
      primaryHref={links.register}
      secondaryLabel={hero.secondaryCta}
      secondaryHref={links.pricing}
    />

    <ProductSection {...sectionProps('setup')}>
      <Fragment slot="heading"><span>{section('setup').headingPre} </span><span class="mark"><em>{section('setup').markEm}</em><Swoosh ink={section('setup').ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><RentalSetupScreen /></Laptop>
    </ProductSection>

    <ProductSection {...sectionProps('manage')}>
      <Fragment slot="heading"><span>{section('manage').headingPre} </span><span class="mark"><em>{section('manage').markEm}</em><Swoosh ink={section('manage').ink} /></span></Fragment>
      <Monitor><RentalsScreen /></Monitor>
    </ProductSection>

    <UseCases kicker={useCases.kicker} heading={useCases.heading} lede={useCases.lede} cards={[...useCases.cards]} />

    <ExtrasGrid tone="dark" kicker={extras.kicker} heading={extras.heading} cards={[...extras.cards]} />

    <PlanCompare kicker={planCompare.kicker} heading={planCompare.heading} lede={planCompare.lede} plans={[...planCompare.plans]} />

    <SignupCta {...signupCta} />
  </main>
  <Footer />
</BaseLayout>
