---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ContactForm from '../../components/contact/ContactForm.astro';
import { links } from '../../config/links';

const page = await getEntry('contactFormPage', 'contact-form');
if (!page) throw new Error('src/content/pages/contact-form.yaml is missing');
const { meta, header } = page.data;
---

<BaseLayout title={meta.title} description={meta.description} canonical={meta.canonical}>
  <Header current="contact" />
  <noscript><style>.up { opacity: 1 !important; transform: none !important; }</style></noscript>
  <main>
    {/* A short band rather than a full hero: this page is a task, and every
        row above the first field is a row between someone and the help they
        came for. */}
    <section class="form-hero" aria-labelledby="form-title" data-reveal>
      <div class="aurora" aria-hidden="true"></div>
      <div class="hero-inner">
        <a class="back up" href={links.contact}>
          <span aria-hidden="true">←</span> All contact options
        </a>
        <h1 id="form-title" class="up">{header.title}</h1>
        <p class="hero-lede up">{header.lede}</p>
      </div>
    </section>

    <ContactForm />
  </main>
  <Footer />
</BaseLayout>

<script>
  const hero = () => document.querySelector('.form-hero')?.classList.add('revealed');
  window.requestAnimationFrame(hero);
  window.setTimeout(hero, 60);

  const targets = document.querySelectorAll('[data-reveal]:not(.form-hero)');
  if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    targets.forEach((target) => target.classList.add('revealed'));
  } else {
    const observer = new IntersectionObserver((entries, obs) => entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('revealed');
      obs.unobserve(entry.target);
    }), { threshold: 0.05 });
    targets.forEach((target) => observer.observe(target));
  }
</script>

<style>
  .form-hero { position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--header-height) + clamp(2.25rem, 4.5vw, 3.5rem)) 0 clamp(2.5rem, 5vw, 3.75rem); color: white; text-align: center; background: radial-gradient(85% 100% at 50% -20%, #1b365e 0%, transparent 58%), linear-gradient(180deg, #0f172b 0%, #070d1a 100%); }
  .hero-inner { position: relative; z-index: 1; width: min(42rem, 90vw); margin-inline: auto; }
  .back { display: inline-flex; align-items: center; gap: .4rem; color: var(--text-muted-dark); font-size: .82rem; font-weight: 700; transition: color 200ms; }
  .back:hover { color: white; }
  h1 { margin: 1.1rem 0 0; font-size: clamp(1.75rem, 3.4vw, 2.75rem); font-weight: 800; letter-spacing: -.03em; line-height: 1.14; }
  .hero-lede { max-width: 46ch; margin: .9rem auto 0; color: var(--text-muted-dark); font-size: clamp(.94rem, 1.2vw, 1.06rem); line-height: 1.7; }
  .aurora { position: absolute; z-index: -3; inset: -25%; opacity: .3; pointer-events: none; background: radial-gradient(circle at 18% 30%, #076da8, transparent 28%), radial-gradient(circle at 82% 20%, #0f89bd, transparent 27%), radial-gradient(circle at 52% 88%, #153d73, transparent 32%); }
  .up { opacity: 0; transform: translateY(1.5rem); transition: opacity 800ms cubic-bezier(.22,1,.36,1), transform 800ms cubic-bezier(.22,1,.36,1); }
  .form-hero.revealed .up { opacity: 1; transform: none; }
  h1.up { transition-delay: 90ms; } .hero-lede.up { transition-delay: 190ms; }
  @media (max-width: 700px) { .form-hero { padding-top: calc(var(--header-height) + 2.25rem); } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; } }
</style>
