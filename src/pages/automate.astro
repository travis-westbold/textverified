---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupCta from '../components/SignupCta.astro';
import Swoosh from '../components/Swoosh.astro';
import ProductHero from '../components/products/ProductHero.astro';
import Laptop from '../components/Laptop.astro';
import Monitor from '../components/Monitor.astro';
import ProductSection from '../components/products/ProductSection.astro';
import ExtrasGrid from '../components/products/ExtrasGrid.astro';
import ApiScreen from '../components/products/ApiScreen.astro';
import BulkScreen from '../components/products/BulkScreen.astro';
import { links } from '../config/links';

const page = await getEntry('automate', 'automate');
if (!page) throw new Error('src/content/pages/automate.yaml is missing');
const { meta, hero, sections, extras, signupCta } = page.data;

const section = (id: (typeof sections)[number]['id']) => {
  const found = sections.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`automate.yaml is missing the "${id}" section`);
  return found;
};

const start = section('start');
const bulk = section('bulk');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Header current="products" />
  <main>
    <ProductHero
      id="automate"
      kicker={hero.kicker}
      title={hero.title}
      mark={hero.mark}
      lede={hero.lede}
      primaryLabel={hero.primaryCta}
      primaryHref={links.register}
      secondaryLabel={hero.secondaryCta}
      secondaryHref={links.apiDocs}
    />

    <ProductSection
      id={start.id} kicker={start.kicker} tone={start.tone} flip={start.flip}
      lede={start.lede} steps={start.steps}
      primaryLabel={start.primaryLabel} primaryHref={start.primaryLink ? links[start.primaryLink] : undefined}
      secondaryLabel={start.secondaryLabel} secondaryHref={start.secondaryLink ? links[start.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{start.headingPre} </span><span class="mark"><em>{start.markEm}</em><Swoosh ink={start.ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><ApiScreen /></Laptop>
    </ProductSection>

    <ProductSection
      id={bulk.id} kicker={bulk.kicker} tone={bulk.tone} flip={bulk.flip}
      lede={bulk.lede} steps={bulk.steps}
      primaryLabel={bulk.primaryLabel} primaryHref={bulk.primaryLink ? links[bulk.primaryLink] : undefined}
      secondaryLabel={bulk.secondaryLabel} secondaryHref={bulk.secondaryLink ? links[bulk.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{bulk.headingPre} </span><span class="mark"><em>{bulk.markEm}</em><Swoosh ink={bulk.ink} /></span></Fragment>
      <Monitor><BulkScreen /></Monitor>
    </ProductSection>

    <ExtrasGrid kicker={extras.kicker} heading={extras.heading} cards={[...extras.cards]} />

    <SignupCta
      heading={signupCta.heading}
      body={signupCta.body}
      buttonLabel={signupCta.buttonLabel}
    />
  </main>
  <Footer />
</BaseLayout>
