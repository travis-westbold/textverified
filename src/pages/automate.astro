---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupCta from '../components/SignupCta.astro';
import Swoosh from '../components/Swoosh.astro';
import ProductHero from '../components/products/ProductHero.astro';
import Laptop from '../components/Laptop.astro';
import Monitor from '../components/Monitor.astro';
import ProductSection from '../components/products/ProductSection.astro';
import ExtrasGrid from '../components/products/ExtrasGrid.astro';
import ApiScreen from '../components/products/ApiScreen.astro';
import BulkScreen from '../components/products/BulkScreen.astro';
import { links } from '../config/links';

const page = await getEntry('automate', 'automate');
if (!page) throw new Error('src/content/pages/automate.yaml is missing');
const { meta, hero, sections, extras, signupCta } = page.data;

const section = (id: (typeof sections)[number]['id']) => {
  const found = sections.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`automate.yaml is missing the "${id}" section`);
  return found;
};

const sectionProps = (id: (typeof sections)[number]['id']) => {
  const data = section(id);
  return {
    id: data.id,
    kicker: data.kicker,
    tone: data.tone,
    flip: data.flip,
    lede: data.lede,
    steps: data.steps,
    primaryLabel: data.primaryLabel,
    primaryHref: data.primaryLink ? links[data.primaryLink] : undefined,
    secondaryLabel: data.secondaryLabel,
    secondaryHref: data.secondaryLink ? links[data.secondaryLink] : undefined,
  };
};
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Header current="products" />
  <main>
    <ProductHero
      id="automate"
      kicker={hero.kicker}
      title={hero.title}
      mark={hero.mark}
      lede={hero.lede}
      primaryLabel={hero.primaryCta}
      primaryHref={links.register}
      secondaryLabel={hero.secondaryCta}
      secondaryHref={links.apiDocs}
    />

    <ProductSection {...sectionProps('start')}>
      <Fragment slot="heading"><span>{section('start').headingPre} </span><span class="mark"><em>{section('start').markEm}</em><Swoosh ink={section('start').ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><ApiScreen /></Laptop>
    </ProductSection>

    <ProductSection {...sectionProps('bulk')}>
      <Fragment slot="heading"><span>{section('bulk').headingPre} </span><span class="mark"><em>{section('bulk').markEm}</em><Swoosh ink={section('bulk').ink} /></span></Fragment>
      <Monitor><BulkScreen /></Monitor>
    </ProductSection>

    <ExtrasGrid kicker={extras.kicker} heading={extras.heading} cards={[...extras.cards]} />

    <SignupCta
      heading={signupCta.heading}
      body={signupCta.body}
      buttonLabel={signupCta.buttonLabel}
    />
  </main>
  <Footer />
</BaseLayout>
