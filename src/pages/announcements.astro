---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupCta from '../components/SignupCta.astro';
import Swoosh from '../components/Swoosh.astro';

const meta = {
  title: 'Announcements | Textverified',
  description: 'Stay current with Textverified product releases, service improvements, and important platform news.',
  canonical: 'https://www.textverified.com/announcements',
};
const hero = {
  kicker: 'Textverified updates',
  headingPre: 'The latest from',
  markEm: 'Textverified',
  lede: 'Product releases, service improvements, and important news—collected in one place.',
};
const feed = {
  kicker: 'What’s new',
  heading: 'Announcements',
  lede: 'Follow along as we make Textverified faster, easier, and more capable.',
  loading: 'Loading the latest announcements…',
  error: 'We couldn’t load announcements right now.',
  retry: 'Try again',
  empty: 'There are no announcements to share yet.',
  latest: 'Latest',
  learnMore: 'Learn more',
  previous: 'Previous',
  next: 'Next',
  page: 'Page',
};
const signupCta = {
  heading: 'Ready to get started?',
  body: 'Create your account and start receiving verification codes in minutes.',
  buttonLabel: 'Sign up now',
};
---

<BaseLayout title={meta.title} description={meta.description} canonical={meta.canonical}>
  <Header />
  <main>
    <section class="announcements-hero" aria-labelledby="announcements-title" data-reveal>
      <div class="aurora" aria-hidden="true"></div>
      <div class="signal signal-one" aria-hidden="true"></div>
      <div class="signal signal-two" aria-hidden="true"></div>
      <div class="hero-inner">
        <span class="kicker up">{hero.kicker}</span>
        <h1 id="announcements-title" class="up">
          {hero.headingPre}<br />
          <span class="mark"><em>{hero.markEm}</em><Swoosh /></span>
        </h1>
        <p class="hero-lede up">{hero.lede}</p>
      </div>
    </section>

    <section class="announcements-section" aria-labelledby="feed-heading">
      <div class="feed-shell shell" data-announcements>
        <header class="section-head">
          <div>
            <span class="section-kicker">{feed.kicker}</span>
            <h2 id="feed-heading">{feed.heading}</h2>
          </div>
          <p>{feed.lede}</p>
        </header>

        <div class="feed-status loading-state" data-loading role="status">
          <span class="sr-only">{feed.loading}</span>
          {[0, 1, 2].map(() => (
            <div class="announcement-card skeleton" aria-hidden="true">
              <span class="skeleton-date"></span>
              <span class="skeleton-title"></span>
              <span class="skeleton-copy"></span>
              <span class="skeleton-copy short"></span>
            </div>
          ))}
        </div>

        <div class="feed-status message-state" data-error hidden role="alert">
          <span class="message-icon" aria-hidden="true">!</span>
          <h3>{feed.error}</h3>
          <button class="button button-outline" type="button" data-retry>{feed.retry}</button>
        </div>

        <div class="feed-status message-state" data-empty hidden role="status">
          <span class="message-icon empty-icon" aria-hidden="true">✓</span>
          <h3>{feed.empty}</h3>
        </div>

        <div class="announcements-list" data-list hidden aria-live="polite"></div>

        <nav class="pagination" data-pagination hidden aria-label="Announcements pages">
          <button class="page-button" type="button" data-previous>
            <span aria-hidden="true">←</span> {feed.previous}
          </button>
          <span class="page-count"><span class="sr-only">{feed.page} </span><span data-page>1</span></span>
          <button class="page-button" type="button" data-next>
            {feed.next} <span aria-hidden="true">→</span>
          </button>
        </nav>
      </div>
    </section>

    <SignupCta {...signupCta} />
  </main>
  <Footer />
</BaseLayout>

<script is:inline define:vars={{
  latestLabel: feed.latest,
  learnMoreLabel: feed.learnMore,
}}>
  const API_URL = 'https://backend.textverified.com/api/v2/announcements/clearable';
  const PAGE_SIZE = 10;

  const root = document.querySelector('[data-announcements]');
  const loading = root?.querySelector('[data-loading]');
  const error = root?.querySelector('[data-error]');
  const empty = root?.querySelector('[data-empty]');
  const list = root?.querySelector('[data-list]');
  const pagination = root?.querySelector('[data-pagination]');
  const previousButton = root?.querySelector('[data-previous]');
  const nextButton = root?.querySelector('[data-next]');
  const pageNumber = root?.querySelector('[data-page]');
  const retryButton = root?.querySelector('[data-retry]');

  let currentPage = 1;
  let currentData = [];
  let hasNext = false;
  let hasPrevious = false;
  const pageKeys = [null];
  let controller;

  const setVisible = (element, visible) => {
    if (element instanceof HTMLElement) element.hidden = !visible;
  };

  const setLoading = (isLoading) => {
    setVisible(loading, isLoading);
    setVisible(error, false);
    setVisible(empty, false);
    setVisible(list, !isLoading && currentData.length > 0);
    setVisible(pagination, !isLoading && currentData.length > 0 && (hasNext || hasPrevious));
    if (previousButton instanceof HTMLButtonElement) previousButton.disabled = isLoading || !hasPrevious;
    if (nextButton instanceof HTMLButtonElement) nextButton.disabled = isLoading || !hasNext;
  };

  const validAnnouncement = (item) => item
    && typeof item.id === 'string'
    && typeof item.title === 'string'
    && typeof item.content === 'string'
    && typeof item.createdAt === 'string'
    && (item.uriPath === null || typeof item.uriPath === 'string');

  const formatDate = (value) => {
    const date = new Date(value);
    if (Number.isNaN(date.valueOf())) return value;
    return new Intl.DateTimeFormat(undefined, {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'UTC',
    }).format(date);
  };

  const safeUrl = (value) => {
    if (!value) return null;
    try {
      const url = new URL(value.trim(), window.location.origin);
      return ['http:', 'https:'].includes(url.protocol) ? url : null;
    } catch {
      return null;
    }
  };

  const renderAnnouncement = (announcement, index) => {
    const article = document.createElement('article');
    article.className = `announcement-card${index === 0 && currentPage === 1 ? ' is-latest' : ''}`;

    const meta = document.createElement('div');
    meta.className = 'announcement-meta';

    const time = document.createElement('time');
    time.dateTime = announcement.createdAt;
    time.textContent = formatDate(announcement.createdAt);
    meta.append(time);

    if (index === 0 && currentPage === 1) {
      const latest = document.createElement('span');
      latest.className = 'latest-pill';
      latest.textContent = latestLabel;
      meta.append(latest);
    }

    const title = document.createElement('h3');
    title.textContent = announcement.title;

    const content = document.createElement('p');
    content.textContent = announcement.content;

    article.append(meta, title, content);

    const destination = safeUrl(announcement.uriPath);
    if (destination) {
      const link = document.createElement('a');
      link.className = 'learn-more';
      link.href = destination.href;
      link.textContent = learnMoreLabel;
      if (destination.origin !== window.location.origin) {
        link.target = '_blank';
        link.rel = 'noreferrer';
      }
      const arrow = document.createElement('span');
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '↗';
      link.append(arrow);
      article.append(link);
    }

    return article;
  };

  const render = () => {
    if (!(list instanceof HTMLElement)) return;
    list.replaceChildren(...currentData.map(renderAnnouncement));
    if (pageNumber) pageNumber.textContent = String(currentPage);
    if (previousButton instanceof HTMLButtonElement) previousButton.disabled = !hasPrevious;
    if (nextButton instanceof HTMLButtonElement) nextButton.disabled = !hasNext;
    setVisible(list, currentData.length > 0);
    setVisible(empty, currentData.length === 0);
    setVisible(pagination, currentData.length > 0 && (hasNext || hasPrevious));
  };

  const loadPage = async (page, key = null) => {
    controller?.abort();
    controller = new AbortController();
    setLoading(true);

    try {
      const url = new URL(API_URL);
      url.searchParams.set('limit', String(PAGE_SIZE));
      if (key) url.searchParams.set('key', key);

      const response = await fetch(url, {
        headers: { Accept: 'application/json' },
        signal: controller.signal,
      });
      if (!response.ok) throw new Error(`Announcements request failed with ${response.status}`);

      const payload = await response.json();
      if (!payload || !Array.isArray(payload.data) || !payload.data.every(validAnnouncement)) {
        throw new Error('Announcements response has an unexpected shape');
      }

      currentPage = page;
      currentData = payload.data;
      hasNext = payload.hasNext === true;
      hasPrevious = page > 1;
      setLoading(false);
      render();
    } catch (requestError) {
      if (requestError instanceof DOMException && requestError.name === 'AbortError') return;
      currentData = [];
      setVisible(loading, false);
      setVisible(list, false);
      setVisible(empty, false);
      setVisible(pagination, false);
      setVisible(error, true);
    }
  };

  nextButton?.addEventListener('click', () => {
    const last = currentData.at(-1);
    if (!hasNext || !last) return;
    pageKeys[currentPage] = last.createdAt;
    void loadPage(currentPage + 1, last.createdAt).then(() => {
      document.querySelector('#feed-heading')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  previousButton?.addEventListener('click', () => {
    if (!hasPrevious) return;
    const previousPage = currentPage - 1;
    void loadPage(previousPage, pageKeys[previousPage - 1] ?? null).then(() => {
      document.querySelector('#feed-heading')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  retryButton?.addEventListener('click', () => {
    void loadPage(currentPage, pageKeys[currentPage - 1] ?? null);
  });

  void loadPage(1);

  const reveal = () => document.querySelector('.announcements-hero')?.classList.add('revealed');
  window.requestAnimationFrame(reveal);
  window.setTimeout(reveal, 60);
</script>

<style>
  .announcements-hero { position: relative; isolation: isolate; overflow: hidden; padding: calc(var(--header-height) + clamp(3.5rem, 7vw, 6.75rem)) 0 clamp(4.25rem, 8vw, 7rem); color: white; text-align: center; background: radial-gradient(85% 100% at 50% -20%, #1b365e 0%, transparent 58%), linear-gradient(180deg, #0f172b 0%, #070d1a 100%); }
  .hero-inner { position: relative; z-index: 1; width: min(51rem, 90vw); margin-inline: auto; }
  .kicker, .section-kicker { display: inline-flex; align-items: center; color: #8fd8f5; font-size: .72rem; font-weight: 800; letter-spacing: .13em; text-transform: uppercase; }
  .kicker { padding: .4rem .9rem; background: rgb(17 177 234 / 10%); border: 1px solid rgb(17 177 234 / 30%); border-radius: 999px; }
  h1 { margin: 1.5rem 0 0; font-size: clamp(2.45rem, 5.5vw, 4.5rem); font-weight: 800; letter-spacing: -.045em; line-height: 1.02; }
  h1 em { color: var(--cyan); font-style: normal; }
  .hero-lede { max-width: 56ch; margin: 1.55rem auto 0; color: #a9bcd8; font-size: clamp(1rem, 1.45vw, 1.15rem); line-height: 1.72; }
  .aurora { position: absolute; z-index: -3; inset: -25%; opacity: .3; pointer-events: none; background: radial-gradient(circle at 18% 30%, #076da8, transparent 28%), radial-gradient(circle at 82% 20%, #0f89bd, transparent 27%), radial-gradient(circle at 52% 88%, #153d73, transparent 32%); }
  .signal { position: absolute; z-index: -1; width: clamp(17rem, 31vw, 28rem); aspect-ratio: 1; border: 1px solid rgb(56 211 255 / 10%); border-radius: 50%; pointer-events: none; }
  .signal::before, .signal::after { content: ''; position: absolute; border: inherit; border-radius: inherit; }
  .signal::before { inset: 16%; }.signal::after { inset: 34%; }
  .signal-one { left: -9rem; bottom: -13rem; }.signal-two { top: -12rem; right: -7rem; }
  .up { opacity: 0; transform: translateY(1.5rem); transition: opacity 800ms cubic-bezier(.22,1,.36,1), transform 800ms cubic-bezier(.22,1,.36,1); }
  .announcements-hero.revealed .up { opacity: 1; transform: none; }
  .kicker.up { transition-delay: 50ms; } h1.up { transition-delay: 150ms; } .hero-lede.up { transition-delay: 280ms; }

  .announcements-section { padding: clamp(4rem, 8vw, 7rem) 0; background: linear-gradient(180deg, #f5f9fd 0%, #fff 28%, #fff 100%); }
  .feed-shell { max-width: 62rem; }
  .section-head { display: grid; grid-template-columns: minmax(0, .85fr) minmax(18rem, 1fr); align-items: end; gap: 2rem; margin-bottom: clamp(2.3rem, 5vw, 3.75rem); }
  .section-kicker { color: var(--brand); }
  .section-head h2 { margin: .65rem 0 0; font-size: clamp(2rem, 4vw, 3.1rem); letter-spacing: -.04em; line-height: 1.06; }
  .section-head p { margin: 0; color: var(--text-muted); font-size: 1rem; line-height: 1.72; }
  .announcements-list, .loading-state { display: grid; gap: 1rem; }
  :global(.announcement-card) { position: relative; padding: clamp(1.45rem, 3.2vw, 2.25rem); overflow: hidden; background: #fff; border-radius: 1.25rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 .85rem 2.5rem -1.8rem rgb(22 63 105 / 30%); }
  :global(.announcement-card)::before { content: ''; position: absolute; inset: 0 auto 0 0; width: .24rem; background: #cbd9e7; }
  :global(.announcement-card.is-latest) { background: linear-gradient(135deg, #fff 45%, #f1f9ff 100%); box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 1rem 3rem -1.7rem rgb(0 105 168 / 38%); }
  :global(.announcement-card.is-latest)::before { background: linear-gradient(180deg, var(--cyan), var(--brand)); }
  :global(.announcement-meta) { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem; }
  :global(.announcement-meta) time { color: #65758b; font-size: .78rem; font-weight: 700; letter-spacing: .035em; text-transform: uppercase; font-variant-numeric: tabular-nums; }
  :global(.latest-pill) { padding: .25rem .6rem; color: #006195; background: #def5ff; border-radius: 999px; font-size: .68rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
  :global(.announcement-card) h3 { max-width: 34ch; margin: .75rem 0 0; font-size: clamp(1.15rem, 2.2vw, 1.45rem); letter-spacing: -.025em; line-height: 1.3; }
  :global(.announcement-card) p { max-width: 72ch; margin: .65rem 0 0; color: var(--text-muted); font-size: .95rem; line-height: 1.7; }
  :global(.learn-more) { display: inline-flex; min-height: 2.5rem; align-items: center; gap: .4rem; margin-top: 1rem; color: var(--brand); font-size: .87rem; font-weight: 800; transition: color 180ms ease, transform 180ms ease; }
  :global(.learn-more):hover { color: #004f80; transform: translateX(.18rem); }:global(.learn-more):active { transform: scale(.96); }
  :global(.learn-more) span { font-size: 1rem; }
  .pagination { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 2rem; }
  .page-button { display: inline-flex; min-height: 2.75rem; align-items: center; justify-content: center; gap: .45rem; padding: .65rem 1rem; color: #334155; background: #fff; border: 0; border-radius: .85rem; box-shadow: 0 1px 2px rgb(15 23 43 / 8%), 0 .5rem 1.4rem -1rem rgb(15 23 43 / 30%); font: 700 .85rem var(--font); cursor: pointer; transition: color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .page-button:first-child { justify-self: start; }.page-button:last-child { justify-self: end; }
  .page-button:hover:not(:disabled) { color: var(--brand); transform: translateY(-2px); box-shadow: 0 1px 2px rgb(15 23 43 / 8%), 0 .8rem 1.6rem -1rem rgb(15 23 43 / 35%); }
  .page-button:active:not(:disabled) { transform: scale(.96); }.page-button:disabled { opacity: .42; cursor: not-allowed; }
  .page-count { display: grid; place-items: center; min-width: 2.75rem; min-height: 2.75rem; color: #4c5b70; background: #eef5fb; border-radius: 50%; font-size: .84rem; font-weight: 800; font-variant-numeric: tabular-nums; }
  .message-state { padding: 3rem 1.5rem; color: var(--text-muted); background: #fff; border-radius: 1.25rem; box-shadow: 0 1px 2px rgb(15 23 43 / 5%), 0 .85rem 2.5rem -1.8rem rgb(22 63 105 / 30%); text-align: center; }
  .message-state h3 { margin: 1rem 0 1.25rem; color: var(--text); font-size: 1.1rem; }
  .message-icon { display: grid; place-items: center; width: 2.7rem; height: 2.7rem; margin-inline: auto; color: #b45309; background: #fff1d6; border-radius: 50%; font-weight: 800; }.empty-icon { color: #047857; background: #dbf7e9; }
  .skeleton { min-height: 11rem; }.skeleton::before { background: #dde8f1; }
  .skeleton span { display: block; border-radius: .45rem; background: linear-gradient(90deg, #edf2f7 20%, #f8fafc 50%, #edf2f7 80%); background-size: 220% 100%; animation: shimmer 1.4s linear infinite; }
  .skeleton-date { width: 7rem; height: .7rem; }.skeleton-title { width: min(25rem, 72%); height: 1.15rem; margin-top: 1rem; }.skeleton-copy { width: 100%; height: .78rem; margin-top: 1rem; }.skeleton-copy.short { width: 67%; margin-top: .55rem; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  [hidden] { display: none !important; }
  @keyframes shimmer { to { background-position: -220% 0; } }
  @media (max-width: 700px) { .section-head { grid-template-columns: 1fr; gap: 1rem; }.announcements-hero { padding-top: calc(var(--header-height) + 3.5rem); }.pagination { gap: .6rem; }.page-button { padding-inline: .8rem; } }
  @media (prefers-reduced-motion: reduce) { .up { opacity: 1; transform: none; transition: none; }.skeleton span { animation: none; }:global(.learn-more):hover, .page-button:hover:not(:disabled) { transform: none; } }
</style>
