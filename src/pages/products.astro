---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SignupCta from '../components/SignupCta.astro';
import Swoosh from '../components/Swoosh.astro';
import ProductHero from '../components/products/ProductHero.astro';
import Laptop from '../components/Laptop.astro';
import Monitor from '../components/Monitor.astro';
import ProductSection from '../components/products/ProductSection.astro';
import ExtrasGrid from '../components/products/ExtrasGrid.astro';
import SmsScreen from '../components/products/SmsScreen.astro';
import ExtensionScreen from '../components/products/ExtensionScreen.astro';
import VoiceScreen from '../components/products/VoiceScreen.astro';
import RentalsScreen from '../components/products/RentalsScreen.astro';
import ApiScreen from '../components/products/ApiScreen.astro';
import CreditsScreen from '../components/products/CreditsScreen.astro';
import { links } from '../config/links';

const page = await getEntry('products', 'products');
if (!page) throw new Error('src/content/pages/products.yaml is missing');
const { meta, hero, jumpLinks, sections, verificationExtras, generalExtras, signupCta } = page.data;

/* Copy comes from the YAML; which device frame and mock screen each section
   gets is layout and stays here, keyed by the section's fixed id. */
const section = (id: (typeof sections)[number]['id']) => {
  const found = sections.find((candidate) => candidate.id === id);
  if (!found) throw new Error(`products.yaml is missing the "${id}" section`);
  return found;
};

const sms = section('sms');
const extension = section('extension');
const voice = section('voice');
const rentals = section('rentals');
const api = section('api');
const credits = section('credits');
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  canonical={meta.canonical}
>
  <Header current="products" />
  <main>
    <!-- ============ hero ============ -->
    <ProductHero
      id="products"
      kicker={hero.kicker}
      title={hero.title}
      mark={hero.mark}
      lede={hero.lede}
      primaryLabel={hero.primaryCta}
      primaryHref={links.register}
      secondaryLabel={hero.secondaryCta}
      secondaryHref={links.pricing}
      jumpLinks={jumpLinks}
    />

    <!-- ============ SMS verifications ============ -->
    <ProductSection
      id={sms.id} kicker={sms.kicker} tone={sms.tone} flip={sms.flip}
      lede={sms.lede} steps={sms.steps}
      primaryLabel={sms.primaryLabel} primaryHref={sms.primaryLink ? links[sms.primaryLink] : undefined}
      secondaryLabel={sms.secondaryLabel} secondaryHref={sms.secondaryLink ? links[sms.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{sms.headingPre} </span><span class="mark"><em>{sms.markEm}</em><Swoosh ink={sms.ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><SmsScreen /></Laptop>
    </ProductSection>

    <!-- ============ Chrome extension ============ -->
    <ProductSection
      id={extension.id} kicker={extension.kicker} tone={extension.tone} flip={extension.flip}
      lede={extension.lede} steps={extension.steps}
      primaryLabel={extension.primaryLabel} primaryHref={extension.primaryLink ? links[extension.primaryLink] : undefined}
      secondaryLabel={extension.secondaryLabel} secondaryHref={extension.secondaryLink ? links[extension.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{extension.headingPre} </span><span class="mark"><em>{extension.markEm}</em><Swoosh ink={extension.ink} /></span></Fragment>
      <Monitor><ExtensionScreen /></Monitor>
    </ProductSection>

    <!-- ============ Voice verifications ============ -->
    <ProductSection
      id={voice.id} kicker={voice.kicker} tone={voice.tone} flip={voice.flip}
      lede={voice.lede} steps={voice.steps}
      primaryLabel={voice.primaryLabel} primaryHref={voice.primaryLink ? links[voice.primaryLink] : undefined}
      secondaryLabel={voice.secondaryLabel} secondaryHref={voice.secondaryLink ? links[voice.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{voice.headingPre} </span><span class="mark"><em>{voice.markEm}</em><Swoosh ink={voice.ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><VoiceScreen /></Laptop>
    </ProductSection>

    <ExtrasGrid tone="dark" kicker={verificationExtras.kicker} heading={verificationExtras.heading} cards={verificationExtras.cards} />

    <!-- ============ Rentals ============ -->
    <ProductSection
      id={rentals.id} kicker={rentals.kicker} tone={rentals.tone} flip={rentals.flip}
      lede={rentals.lede} steps={rentals.steps}
      primaryLabel={rentals.primaryLabel} primaryHref={rentals.primaryLink ? links[rentals.primaryLink] : undefined}
      secondaryLabel={rentals.secondaryLabel} secondaryHref={rentals.secondaryLink ? links[rentals.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{rentals.headingPre} </span><span class="mark"><em>{rentals.markEm}</em><Swoosh ink={rentals.ink} /></span></Fragment>
      <Monitor><RentalsScreen /></Monitor>
    </ProductSection>

    <!-- ============ API ============ -->
    <ProductSection
      id={api.id} kicker={api.kicker} tone={api.tone} flip={api.flip}
      lede={api.lede} steps={api.steps}
      primaryLabel={api.primaryLabel} primaryHref={api.primaryLink ? links[api.primaryLink] : undefined}
      secondaryLabel={api.secondaryLabel} secondaryHref={api.secondaryLink ? links[api.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{api.headingPre} </span><span class="mark"><em>{api.markEm}</em><Swoosh ink={api.ink} /></span></Fragment>
      <Laptop width="min(40rem, 100%)"><ApiScreen /></Laptop>
    </ProductSection>

    <!-- ============ Credits ============ -->
    <ProductSection
      id={credits.id} kicker={credits.kicker} tone={credits.tone} flip={credits.flip}
      lede={credits.lede} steps={credits.steps}
      primaryLabel={credits.primaryLabel} primaryHref={credits.primaryLink ? links[credits.primaryLink] : undefined}
      secondaryLabel={credits.secondaryLabel} secondaryHref={credits.secondaryLink ? links[credits.secondaryLink] : undefined}
    >
      <Fragment slot="heading"><span>{credits.headingPre} </span><span class="mark"><em>{credits.markEm}</em><Swoosh ink={credits.ink} /></span></Fragment>
      <Monitor><CreditsScreen /></Monitor>
    </ProductSection>

    <ExtrasGrid tone="dark" kicker={generalExtras.kicker} heading={generalExtras.heading} cards={generalExtras.cards} />

    <SignupCta
      heading={signupCta.heading}
      body={signupCta.body}
      buttonLabel={signupCta.buttonLabel}
    />
  </main>
  <Footer />
</BaseLayout>
